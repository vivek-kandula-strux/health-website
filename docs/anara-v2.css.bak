/* ============================================================
   Anara V2 — Glassmorphism / Cinematic Depth
   Frosted glass + cursor-aware micro-interactions.
   Scoped under .v2-glass; inherits brand tokens from anara.css.
   ============================================================ */

.v2-glass {
  /* Glass surfaces — 5 tiers, see docs/design-system.md §5 */
  --glass-04: rgba(255,255,255,0.04);
  --glass-18: rgba(255,255,255,0.18);
  --glass-40: rgba(255,255,255,0.40);
  --glass-65: rgba(255,255,255,0.65);
  --glass-92: rgba(255,255,255,0.92);

  --g-glass-bg: var(--glass-65);
  --g-glass-border: 1px solid rgba(255,255,255,0.6);
  --g-glass-shadow: 0 24px 60px -28px rgba(36,12,52,0.28);
  --g-glass-shadow-hover: 0 36px 80px -32px rgba(36,12,52,0.36);
  --g-glass-blur: blur(20px) saturate(150%);
  --g-radius-card: 28px;
  --g-radius-badge: 20px;

  /* Mesh keeps its bright #A62EE2 stop — decorative gradient brightener,
     not a semantic accent. Pairs with --purple-900 for depth. */
  --g-mesh: radial-gradient(ellipse at top right, #A62EE2 0%, var(--purple-900) 80%);
  --g-lavender: linear-gradient(180deg, #FBFAFF 0%, #F0E6F5 100%);
  --g-ease: cubic-bezier(0.22, 1, 0.36, 1);
  --g-ticker-h: 92px;
}

/* Global focus-visible polish (smooth fade-in) */
.v2-glass :focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 6px;
  transition: outline-offset .18s var(--g-ease);
}

/* Reveal-on-scroll primitive */
.v2-glass .reveal { opacity: 0; transform: translateY(8px); transition: opacity .6s var(--g-ease), transform .6s var(--g-ease); }
.v2-glass .reveal.is-visible { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) { .v2-glass .reveal { opacity: 1; transform: none; transition: none; } }

/* Glass nav */
.v2-glass .nav-wrap {
  background: rgba(251,250,255,0.7);
  backdrop-filter: blur(14px) saturate(150%);
  -webkit-backdrop-filter: blur(14px) saturate(150%);
  border-bottom: 1px solid rgba(231,228,237,0.5);
}

/* Universal glass card + cursor-glow surface */
.v2-glass .g-glass-card {
  position: relative;
  background: var(--g-glass-bg);
  backdrop-filter: var(--g-glass-blur);
  -webkit-backdrop-filter: var(--g-glass-blur);
  border: var(--g-glass-border);
  border-radius: var(--g-radius-card);
  box-shadow: var(--g-glass-shadow);
  overflow: hidden;
  isolation: isolate;
  transition: transform .28s var(--g-ease), box-shadow .28s var(--g-ease), background .28s var(--g-ease);
}
.v2-glass .g-glass-card::after {
  content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
  background: radial-gradient(300px circle at var(--mx, -100px) var(--my, -100px), rgba(255,255,255,0.55), transparent 65%);
  opacity: 0; transition: opacity .25s var(--g-ease);
}
.v2-glass .g-glass-card:hover::after { opacity: 1; }
.v2-glass .g-glass-card:hover { transform: translateY(-6px); box-shadow: var(--g-glass-shadow-hover); background: rgba(255,255,255,0.86); }
@media (prefers-reduced-motion: reduce) {
  .v2-glass .g-glass-card, .v2-glass .g-glass-card:hover { transform: none; transition: none; }
  .v2-glass .g-glass-card::after { display: none; }
}

/* HERO — cinematic full-bleed + glass overlay */
.v2-glass .g-hero { padding: 0; position: relative; }
.v2-glass .g-hero-bleed { position: relative; min-height: clamp(680px, 88vh, 900px); overflow: hidden; }
.v2-glass .g-hero-bleed::before {
  content: ""; position: absolute; inset: 0; z-index: 2;
  background: linear-gradient(105deg, rgba(26,11,38,0.66) 0%, rgba(26,11,38,0.38) 50%, rgba(26,11,38,0.18) 100%);
}
.v2-glass .g-hero-parallax {
  position: absolute; inset: 0; will-change: transform;
}
.v2-glass .g-hero-parallax > img {
  position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  object-position: 70% 28%;
  will-change: transform;
}

.v2-glass .g-hero-overlay {
  position: relative; z-index: 3;
  display: flex; align-items: flex-start;
  padding-top: clamp(80px, 12vh, 140px);
  padding-bottom: calc(var(--g-ticker-h) + 48px);
}
.v2-glass .g-hero-glass {
  max-width: 600px;
  background: rgba(255,255,255,0.96);
  backdrop-filter: var(--g-glass-blur);
  -webkit-backdrop-filter: var(--g-glass-blur);
  border: var(--g-glass-border);
  border-radius: var(--g-radius-card);
  padding: 44px 44px 40px;
  box-shadow: 0 30px 80px rgba(26,11,38,0.32);
  animation: gFadeUp .8s var(--g-ease) both;
}
/* Defensive fallback — browsers without backdrop-filter (some older Edge / print / screenshot tools) get a solid card */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .v2-glass .g-hero-glass { background: #FBF8FF; }
}
@keyframes gFadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
.v2-glass .g-trust {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 6px 14px; margin-bottom: 22px;
  background: rgba(143,16,140,0.06);
  border: 1px solid rgba(143,16,140,0.18);
  border-radius: 999px;
  font-size: 13px; color: var(--ink-2);
}
.v2-glass .g-trust .dot { width: 8px; height: 8px; border-radius: 50%; background: #2EBE7A; box-shadow: 0 0 0 4px rgba(46,190,122,0.2); }
.v2-glass .g-hero-glass h1 {
  font-family: var(--serif); font-weight: 500;
  font-size: clamp(34px,4.6vw,60px); line-height: 1.04; letter-spacing: -0.03em;
  color: var(--ink); margin: 0 0 18px; max-width: 14ch;
}
.v2-glass .g-hero-glass p { color: var(--ink-2); font-size: 16px; line-height: 1.6; margin: 0 0 28px; max-width: 50ch; }
.v2-glass .g-cta { display: flex; gap: 12px; flex-wrap: wrap; }

/* Hero stat ticker */
.v2-glass .g-ticker {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; margin: 0;
  min-height: var(--g-ticker-h);
  background: rgba(16,8,28,0.7);
  backdrop-filter: blur(18px) saturate(140%);
  -webkit-backdrop-filter: blur(18px) saturate(140%);
  border-top: 1px solid rgba(255,255,255,0.1);
}
.v2-glass .g-ticker-inner { display: grid; grid-template-columns: repeat(4,1fr); gap: 24px; padding: 22px 24px; color: #fff; }
.v2-glass .g-ticker-inner > div { padding-left: 18px; border-left: 1px solid rgba(255,255,255,0.15); }
.v2-glass .g-ticker-inner > div:first-child { border-left: 0; padding-left: 0; }
.v2-glass .g-ticker-inner dt, .v2-glass .g-ticker-inner dd { display: block; margin: 0; line-height: 1.15; }
.v2-glass .g-ticker-inner strong { font-family: var(--serif); font-weight: 500; font-size: clamp(22px,2vw,30px); color: #fff; letter-spacing: -0.01em; }
.v2-glass .g-ticker-inner em { font-style: normal; font-size: 0.55em; opacity: 0.7; }
.v2-glass .g-ticker-inner dd { font-size: 12px; color: rgba(255,255,255,0.78); letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }

/* MISSION — purple mesh + glass tile */
.v2-glass .g-mission { padding: 120px 0; background: var(--g-mesh); position: relative; overflow: hidden; }
.v2-glass .g-mission::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.08), transparent 50%); }
.v2-glass .g-mission-card {
  position: relative; z-index: 1; max-width: 880px; margin: 0 auto;
  background: rgba(255,255,255,0.88);
  backdrop-filter: var(--g-glass-blur);
  -webkit-backdrop-filter: var(--g-glass-blur);
  border: var(--g-glass-border);
  border-radius: var(--g-radius-card);
  padding: 64px 56px; text-align: center;
  box-shadow: 0 40px 100px rgba(26,11,38,0.35);
}
.v2-glass .g-mission-card .mission-text {
  margin: 0 auto; font-family: var(--serif); font-weight: 400;
  font-size: clamp(28px,4vw,48px); line-height: 1.18; letter-spacing: -0.02em;
  color: var(--ink); max-width: 22ch;
}

/* ABOUT — image left + overlapping glass right (desktop) */
.v2-glass .g-about { padding: 100px 0; background: var(--g-lavender); }
.v2-glass .g-about-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: center; gap: 0; }
.v2-glass .g-about-media {
  position: relative; border-radius: var(--g-radius-card);
  overflow: hidden; aspect-ratio: 4/5;
  box-shadow: 0 30px 70px rgba(26,11,38,0.22);
}
.v2-glass .g-about-media img { width: 100%; height: 100%; object-fit: cover; }
.v2-glass .g-about-stat {
  position: absolute; bottom: 22px; left: 22px;
  background: rgba(255,255,255,0.92);
  backdrop-filter: var(--g-glass-blur);
  -webkit-backdrop-filter: var(--g-glass-blur);
  border: var(--g-glass-border);
  border-radius: var(--g-radius-badge);
  padding: 16px 22px;
  box-shadow: 0 16px 40px rgba(26,11,38,0.2);
}
.v2-glass .g-about-stat strong { display: block; font-family: var(--serif); font-weight: 600; font-size: 32px; color: var(--accent); line-height: 1; }
.v2-glass .g-about-stat span { font-size: 12px; color: var(--ink-2); font-weight: 500; }
.v2-glass .g-about-glass {
  background: rgba(255,255,255,0.88);
  backdrop-filter: var(--g-glass-blur);
  -webkit-backdrop-filter: var(--g-glass-blur);
  border: var(--g-glass-border);
  border-radius: var(--g-radius-card);
  padding: 44px;
  box-shadow: 0 30px 80px rgba(26,11,38,0.18);
  position: relative; z-index: 2;
}
/* removed translateX(-64px) — was clipping the .g-about-stat badge on the right edge of the dashboard */
.v2-glass .g-about-glass h2 { font-size: clamp(28px,3.4vw,42px); line-height: 1.1; letter-spacing: -0.02em; margin: 10px 0 16px; }
.v2-glass .g-about-glass p { color: var(--ink-2); font-size: 16px; line-height: 1.6; }
.v2-glass .g-about-glass .muted { color: var(--muted); margin: 18px 0 22px; font-size: 15px; }
.v2-glass .g-pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 4px; }
.v2-glass .g-pills li {
  background: rgba(255,255,255,0.78);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(143,16,140,0.22);
  border-radius: 999px;
  padding: 8px 14px; font-size: 13px; font-weight: 500; color: var(--accent);
  transition: background .25s var(--g-ease), color .25s var(--g-ease);
}
.v2-glass .g-pills li:hover { background: var(--accent); color: #fff; }

/* WHY — mesh wash + 2x2 glass cards */
.v2-glass .g-why {
  padding: 110px 0;
  background:
    radial-gradient(ellipse at 0% 0%, rgba(166,46,226,0.08), transparent 50%),
    radial-gradient(ellipse at 100% 100%, rgba(143,16,140,0.06), transparent 50%),
    var(--g-lavender);
}
.v2-glass .g-why-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 22px; }
.v2-glass .g-why-grid .g-glass-card { padding: 36px 32px; min-height: 220px; display: flex; flex-direction: column; gap: 12px; }
.v2-glass .g-why-grid .num { font-family: var(--serif); font-weight: 600; font-size: 14px; color: var(--accent); letter-spacing: 0.16em; }
.v2-glass .g-why-grid h3 { font-size: 22px; line-height: 1.25; }
.v2-glass .g-why-grid p { color: var(--ink-2); font-size: 15px; line-height: 1.6; }

/* SERVICES — full-bleed imagery + glass cards */
.v2-glass .g-services { position: relative; padding: 110px 0; overflow: hidden; isolation: isolate; }
.v2-glass .g-services-bg { position: absolute; inset: 0; z-index: -1; }
.v2-glass .g-services-bg img { width: 100%; height: 100%; object-fit: cover; }
.v2-glass .g-services-bg::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(26,11,38,0.82) 0%, rgba(26,11,38,0.68) 60%, rgba(26,11,38,0.84) 100%);
}
.v2-glass .g-section-head-light .eyebrow { color: #E9C9F0; }
.v2-glass .g-section-head-light h2 { color: #fff; }
.v2-glass .g-section-head-light .section-sub { color: rgba(255,255,255,0.85); }
.v2-glass .g-services-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 22px; }
.v2-glass .g-service-card { padding: 32px 28px 28px; position: relative; display: block; }
.v2-glass .g-service-icon {
  width: 52px; height: 52px; border-radius: 14px;
  background: linear-gradient(135deg, #F8E4F8, #EFC9F0);
  color: var(--accent);
  display: inline-flex; align-items: center; justify-content: center; margin-bottom: 18px;
  box-shadow: inset 0 0 0 1px rgba(143,16,140,0.18);
  transition: transform .28s var(--g-ease), box-shadow .28s var(--g-ease);
}
.v2-glass .g-service-card:hover .g-service-icon { transform: scale(1.06); box-shadow: inset 0 0 0 1px rgba(143,16,140,0.3), 0 8px 24px rgba(143,16,140,0.18); }
.v2-glass .g-service-card h3 { font-size: 20px; margin-bottom: 8px; line-height: 1.3; }
.v2-glass .g-service-card p { color: var(--ink-2); font-size: 15px; line-height: 1.55; max-width: 38ch; }
.v2-glass .g-service-card .arrow {
  position: absolute; right: 28px; top: 32px;
  width: 38px; height: 38px; border-radius: 50%;
  background: var(--accent-soft); color: var(--accent);
  display: inline-flex; align-items: center; justify-content: center; font-size: 16px;
  transition: background .28s var(--g-ease), color .28s var(--g-ease), transform .28s var(--g-ease), box-shadow .28s var(--g-ease);
}
.v2-glass .g-service-card:hover .arrow { background: var(--accent); color: #fff; transform: translateX(6px); box-shadow: 0 0 0 6px rgba(143,16,140,0.14), 0 10px 24px rgba(143,16,140,0.32); }

/* PROCESS — deep purple gradient + glass steps */
.v2-glass .g-process { padding: 110px 0; background: var(--g-mesh); position: relative; overflow: hidden; }
.v2-glass .g-process::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 80% 20%, rgba(255,255,255,0.06), transparent 60%); }
.v2-glass .g-process-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 18px; position: relative; z-index: 1; }
.v2-glass .g-step { padding: 32px 26px 28px; display: flex; flex-direction: column; gap: 10px; }
.v2-glass .g-step-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 48px; height: 48px; border-radius: 14px;
  background: var(--accent); color: #fff;
  font-family: var(--serif); font-weight: 600; font-size: 22px; margin-bottom: 8px;
}
.v2-glass .g-step h3 { font-size: 19px; line-height: 1.25; }
.v2-glass .g-step p { color: var(--ink-2); font-size: 14px; line-height: 1.55; }

/* GALLERY — proper masonry-feel grid */
.v2-glass .g-gallery { padding: 110px 0; background: var(--g-lavender); }
.v2-glass .g-gallery-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 320px; gap: 16px; }
.v2-glass .g-gcard {
  position: relative; margin: 0; overflow: hidden;
  border-radius: var(--g-radius-card);
  box-shadow: 0 24px 60px rgba(26,11,38,0.18);
}
.v2-glass .g-gcard.g-tall { grid-row: span 2; }
.v2-glass .g-gcard img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--g-ease); }
.v2-glass .g-gcard:hover img { transform: scale(1.05); }
.v2-glass .g-gcard::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(26,11,38,0) 55%, rgba(26,11,38,0.35) 100%); pointer-events: none; }
.v2-glass .g-caption {
  position: absolute; left: 16px; bottom: 16px; right: 16px; z-index: 2;
  background: rgba(255,255,255,0.9);
  backdrop-filter: var(--g-glass-blur);
  -webkit-backdrop-filter: var(--g-glass-blur);
  border: var(--g-glass-border);
  border-radius: var(--g-radius-badge);
  padding: 14px 18px;
  box-shadow: 0 14px 40px rgba(26,11,38,0.22);
}
.v2-glass .g-caption h3 { font-family: var(--serif); font-weight: 500; font-size: 16px; color: var(--ink); margin-bottom: 2px; line-height: 1.25; }
.v2-glass .g-caption p { font-size: 12px; color: var(--ink-2); line-height: 1.45; }

/* TEAM — team photo bg + glass quote */
.v2-glass .g-team { position: relative; padding: 110px 0; overflow: hidden; isolation: isolate; }
.v2-glass .g-team-bg { position: absolute; inset: 0; z-index: -1; }
.v2-glass .g-team-bg img { width: 100%; height: 100%; object-fit: cover; }
.v2-glass .g-team-bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(26,11,38,0.78) 0%, rgba(74,11,107,0.74) 100%); }
.v2-glass .g-team-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
.v2-glass .g-team-copy .eyebrow { color: #E9C9F0; }
.v2-glass .g-team-copy h2 { color: #fff; font-size: clamp(28px,3.4vw,44px); line-height: 1.1; letter-spacing: -0.02em; margin: 8px 0 16px; }
.v2-glass .g-team-copy .section-sub { color: rgba(255,255,255,0.86); margin-bottom: 28px; }
.v2-glass .g-team-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid rgba(255,255,255,0.18); }
.v2-glass .g-team-list li {
  display: flex; align-items: baseline; gap: 14px;
  padding: 16px 6px;
  border-bottom: 1px solid rgba(255,255,255,0.14);
  font-family: var(--serif); font-size: 17px; color: #fff;
}
.v2-glass .g-team-list li span { color: #E9C9F0; font-size: 11px; font-family: var(--sans); font-weight: 700; letter-spacing: 0.12em; min-width: 22px; }
.v2-glass .g-team-quote { padding: 36px; display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: start; margin: 0; }
.v2-glass .g-team-quote img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255,255,255,0.85); }
.v2-glass .g-team-quote blockquote { margin: 0; grid-column: span 2; }
.v2-glass .g-team-quote blockquote p { font-family: var(--serif); font-size: 18px; line-height: 1.45; color: var(--ink); margin-bottom: 12px; }
.v2-glass .g-team-quote blockquote footer { font-size: 13px; color: var(--ink-2); font-weight: 500; }
.v2-glass .g-team-quote blockquote footer strong { color: var(--ink); font-weight: 600; }
.v2-glass .g-team-quote .btn { grid-column: span 2; justify-self: start; }

/* TESTIMONIALS — lavender wash + 3 glass cards */
.v2-glass .g-testimonials { padding: 110px 0; background: radial-gradient(ellipse at 50% 0%, rgba(166,46,226,0.1), transparent 60%), var(--g-lavender); }
.v2-glass .g-t-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; align-items: center; }
.v2-glass .g-t-card { padding: 32px 28px; display: flex; flex-direction: column; gap: 14px; }
.v2-glass .g-t-feature {
  background: linear-gradient(180deg, rgba(143,16,140,0.96) 0%, rgba(74,11,107,0.96) 100%);
  border: 1px solid rgba(255,255,255,0.22);
  box-shadow: 0 36px 80px rgba(143,16,140,0.42);
  transform: translateY(-12px);
}
.v2-glass .g-t-feature:hover { transform: translateY(-18px); background: linear-gradient(180deg, rgba(143,16,140,0.96) 0%, rgba(74,11,107,0.96) 100%); }
.v2-glass .g-t-feature p, .v2-glass .g-t-feature footer strong, .v2-glass .g-t-feature footer span { color: #fff; }
.v2-glass .g-t-feature footer span { opacity: 0.82; }
.v2-glass .g-t-feature .stars { color: #FFD58A; }
.v2-glass .g-t-card .stars { color: var(--gold); letter-spacing: 2px; font-size: 14px; }
.v2-glass .g-t-card > p { font-family: var(--serif); font-size: 18px; line-height: 1.5; color: var(--ink); }
.v2-glass .g-t-card footer { display: flex; align-items: center; gap: 12px; margin-top: auto; }
.v2-glass .g-t-card footer img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
.v2-glass .g-t-card footer strong { display: block; font-size: 14px; color: var(--ink); font-weight: 600; }
.v2-glass .g-t-card footer span { display: block; font-size: 12px; color: var(--ink-2); }

/* PRINCIPLES — 2x2 glass tiles */
.v2-glass .g-principles { padding: 110px 0; background: var(--g-lavender); }
.v2-glass .g-principle-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 22px; }
.v2-glass .g-p-card { padding: 36px 32px; }
.v2-glass .g-p-icon {
  width: 52px; height: 52px; border-radius: 16px;
  background: linear-gradient(135deg, #F8E4F8, #EFC9F0); color: var(--accent);
  display: inline-flex; align-items: center; justify-content: center; margin-bottom: 18px;
  box-shadow: inset 0 0 0 1px rgba(143,16,140,0.18);
}
.v2-glass .g-p-card h3 { font-size: 20px; margin-bottom: 8px; line-height: 1.25; }
.v2-glass .g-p-card p { color: var(--ink-2); font-size: 15px; line-height: 1.6; }

/* FAQ — JS-animated accordion */
.v2-glass .g-faq { padding: 110px 0; background: radial-gradient(ellipse at 100% 0%, rgba(143,16,140,0.07), transparent 50%), var(--g-lavender); }
.v2-glass .g-faq-list { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
.v2-glass .g-faq-item { padding: 0; overflow: hidden; }
.v2-glass .g-faq-item summary {
  list-style: none; cursor: pointer;
  padding: 22px 28px;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  font-family: var(--serif); font-weight: 500;
  font-size: 18px; color: var(--ink);
  user-select: none;
}
.v2-glass .g-faq-item summary::-webkit-details-marker { display: none; }
.v2-glass .g-faq-item summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 18px; }
.v2-glass .g-faq-item .chev {
  position: relative; width: 26px; height: 26px; flex-shrink: 0;
  border-radius: 50%; background: var(--accent-soft);
  transition: transform .28s var(--g-ease), background .28s var(--g-ease);
}
.v2-glass .g-faq-item .chev::before, .v2-glass .g-faq-item .chev::after {
  content: ""; position: absolute; top: 50%; left: 50%;
  background: var(--accent); border-radius: 1px; transform: translate(-50%,-50%);
}
.v2-glass .g-faq-item .chev::before { width: 10px; height: 2px; }
.v2-glass .g-faq-item .chev::after { width: 2px; height: 10px; transition: transform .28s var(--g-ease); }
.v2-glass .g-faq-item[open] .chev { transform: rotate(180deg); background: var(--accent); }
.v2-glass .g-faq-item[open] .chev::before { background: #fff; }
.v2-glass .g-faq-item[open] .chev::after { background: #fff; transform: translate(-50%,-50%) scaleY(0); }

/* JS-driven smooth height: wrap body in .g-faq-body */
.v2-glass .g-faq-body {
  height: 0; overflow: hidden;
  transition: height .28s var(--g-ease);
  will-change: height;
}
.v2-glass .g-faq-body p { padding: 0 28px 24px; color: var(--ink-2); font-size: 15px; line-height: 1.65; max-width: 64ch; margin: 0; }
@media (prefers-reduced-motion: reduce) { .v2-glass .g-faq-body { transition: none; } }

/* CTA — full-bleed purple gradient + glass card */
.v2-glass .g-cta { padding: 110px 0; background: var(--g-mesh); position: relative; overflow: hidden; }
.v2-glass .g-cta::after {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(circle at 15% 80%, rgba(255,255,255,0.08), transparent 45%), radial-gradient(circle at 85% 20%, rgba(255,255,255,0.07), transparent 45%);
}
.v2-glass .g-cta-glass {
  position: relative; z-index: 1; max-width: 880px; margin: 0 auto;
  background: rgba(255,255,255,0.14);
  backdrop-filter: blur(22px) saturate(160%);
  -webkit-backdrop-filter: blur(22px) saturate(160%);
  border: 1px solid rgba(255,255,255,0.28);
  border-radius: var(--g-radius-card);
  padding: 64px 56px; text-align: center; color: #fff;
  box-shadow: 0 40px 100px rgba(26,11,38,0.4);
}
.v2-glass .g-cta-glass h2 { font-size: clamp(32px,4.6vw,56px); color: #fff; line-height: 1.08; letter-spacing: -0.02em; max-width: 18ch; margin: 0 auto 16px; }
.v2-glass .g-cta-glass > p { color: rgba(255,255,255,0.88); font-size: 17px; max-width: 50ch; margin: 0 auto 32px; }
.v2-glass .g-cta-glass .cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.v2-glass .g-cta-glass .btn-primary { background: #fff; color: var(--accent); }
.v2-glass .g-cta-glass .btn-primary:hover { background: var(--accent-soft); }
.v2-glass .g-cta-glass .cta-contact { margin-top: 30px; display: flex; gap: 16px; justify-content: center; align-items: center; flex-wrap: wrap; font-size: 14px; color: rgba(255,255,255,0.9); }
.v2-glass .g-cta-glass .cta-contact a { color: #fff; font-weight: 500; border-bottom: 1px solid rgba(255,255,255,0.4); padding: 2px 0; }
.v2-glass .g-cta-glass .cta-contact a:hover { border-color: #fff; }
.v2-glass .g-cta-glass .cta-contact span { opacity: 0.6; }

/* FOOTER */
.v2-glass .g-footer { background: #1A0B26; }
.v2-glass .g-footer .footer-grid > .f-col { padding-left: 24px; border-left: 1px solid rgba(255,255,255,0.06); }
.v2-glass .g-footer .footer-grid > .f-col:first-of-type { border-left: 0; padding-left: 0; }
.v2-glass .g-footer .socials a { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); backdrop-filter: blur(8px); }

/* Responsive */
@media (max-width: 980px) {
  .v2-glass { --g-ticker-h: 140px; }
  .v2-glass .g-hero-bleed { height: auto; min-height: 720px; }
  .v2-glass .g-hero-overlay { padding-top: 96px; padding-bottom: calc(var(--g-ticker-h) + 24px); }
  .v2-glass .g-hero-glass { padding: 36px 32px; }
  .v2-glass .g-ticker-inner { grid-template-columns: repeat(2,1fr); gap: 16px; }
  .v2-glass .g-ticker-inner > div:nth-child(3) { border-left: 0; padding-left: 0; }
  .v2-glass .g-mission { padding: 80px 0; }
  .v2-glass .g-mission-card { padding: 48px 32px; }
  .v2-glass .g-about-grid { grid-template-columns: 1fr; gap: 24px; }
  .v2-glass .g-about-glass { transform: none; margin: 0; padding: 32px; }
  .v2-glass .g-why-grid, .v2-glass .g-services-grid, .v2-glass .g-principle-grid { grid-template-columns: 1fr 1fr; }
  .v2-glass .g-process-grid { grid-template-columns: repeat(2,1fr); }
  .v2-glass .g-gallery-grid { grid-template-columns: repeat(2,1fr); grid-auto-rows: 280px; }
  .v2-glass .g-gcard.g-tall { grid-row: span 1; }
  .v2-glass .g-team-inner { grid-template-columns: 1fr; gap: 36px; }
  .v2-glass .g-t-grid { grid-template-columns: 1fr; }
  .v2-glass .g-t-feature { transform: none; }
  .v2-glass .g-t-feature:hover { transform: translateY(-6px); }
  .v2-glass .g-footer .footer-grid > .f-col { padding-left: 0; border-left: 0; }
}
@media (max-width: 540px) {
  .v2-glass { --g-ticker-h: 220px; }
  .v2-glass .g-hero-bleed { min-height: 760px; }
  .v2-glass .g-hero-overlay { padding-top: 80px; padding-bottom: calc(var(--g-ticker-h) + 20px); }
  .v2-glass .g-hero-glass { padding: 28px 24px; border-radius: 22px; }
  .v2-glass .g-hero-glass h1 { font-size: 32px; }
  .v2-glass .g-ticker-inner { grid-template-columns: 1fr 1fr; padding: 18px; }
  .v2-glass .g-mission { padding: 64px 0; }
  .v2-glass .g-mission-card { padding: 36px 24px; border-radius: 22px; }
  .v2-glass .g-about { padding: 72px 0; }
  .v2-glass .g-about-glass { padding: 28px 24px; border-radius: 22px; }
  .v2-glass .g-why, .v2-glass .g-services, .v2-glass .g-process,
  .v2-glass .g-gallery, .v2-glass .g-team, .v2-glass .g-testimonials,
  .v2-glass .g-principles, .v2-glass .g-faq, .v2-glass .g-cta { padding: 72px 0; }
  .v2-glass .g-why-grid, .v2-glass .g-services-grid, .v2-glass .g-process-grid,
  .v2-glass .g-principle-grid, .v2-glass .g-gallery-grid { grid-template-columns: 1fr; }
  .v2-glass .g-gallery-grid { grid-auto-rows: auto; }
  .v2-glass .g-gcard { aspect-ratio: 4/3; }
  .v2-glass .g-team-list { grid-template-columns: 1fr; }
  .v2-glass .g-cta-glass { padding: 44px 28px; border-radius: 22px; }
  .v2-glass .g-cta-glass h2 { font-size: 32px; }
}
