                d="M13.5 21v-7.5h2.5l.4-3H13.5V8.6c0-.9.25-1.5 1.55-1.5H16.5V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.5v3h2.3V21h3.7z" />
            </svg></a>
          <a href="https://www.instagram.com/" aria-label="Anara on Instagram" rel="noopener"><svg viewBox="0 0 24 24"
              width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
