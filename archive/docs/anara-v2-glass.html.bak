  <script src="script.js"></script>

  <!-- V2 Glass micro-interactions -->
  <script>
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Cursor-glow on glass cards
      document.querySelectorAll('.v2-glass .g-glass-card').forEach(function (card) {
        card.addEventListener('pointermove', function (e) {
          var r = card.getBoundingClientRect();
          card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          card.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });
        card.addEventListener('pointerleave', function () {
          card.style.setProperty('--mx', '-200px');
          card.style.setProperty('--my', '-200px');
        });
      });

      // 2) FAQ smooth accordion (single-open)
      var faqItems = document.querySelectorAll('.v2-glass .g-faq-item');
      faqItems.forEach(function (item) {
        var summary = item.querySelector('summary');
        var body = item.querySelector('.g-faq-body');
        if (!summary || !body) return;
        // ensure starts collapsed if not open
        if (!item.open) body.style.height = '0px';

        summary.addEventListener('click', function (e) {
          e.preventDefault();
          var isOpen = item.open;
          if (isOpen) {
            // close
            var current = body.scrollHeight;
            body.style.height = current + 'px';
            requestAnimationFrame(function () {
              body.style.height = '0px';
            });
            body.addEventListener('transitionend', function handler() {
              item.open = false;
              body.removeEventListener('transitionend', handler);
            });
          } else {
            // close siblings
            faqItems.forEach(function (other) {
              if (other !== item && other.open) {
                var ob = other.querySelector('.g-faq-body');
                var oh = ob.scrollHeight;
                ob.style.height = oh + 'px';
                requestAnimationFrame(function () { ob.style.height = '0px'; });
                ob.addEventListener('transitionend', function h() { other.open = false; ob.removeEventListener('transitionend', h); });
              }
            });
            item.open = true;
            body.style.height = '0px';
            requestAnimationFrame(function () {
              body.style.height = body.scrollHeight + 'px';
            });
            body.addEventListener('transitionend', function handler() {
              body.style.height = 'auto';
              body.removeEventListener('transitionend', handler);
            });
          }
        });
      });

      // 3) Animated stat ticker (count up on view, but never below current shown value)
      var counters = document.querySelectorAll('.v2-glass [data-count]');
      var counted = new WeakSet();
      function animateCount(el) {
        if (counted.has(el)) return;
        counted.add(el);
        var target = parseFloat(el.getAttribute('data-count'));
        var suffix = el.getAttribute('data-suffix') || '';
        var decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
        var em = el.querySelector('em');
        var emHTML = em ? em.outerHTML : '';
        if (reduce) {
          el.innerHTML = target.toFixed(decimals) + suffix + emHTML;
          return;
        }
        // Animate from 0 → target on view; final paint matches target value so SEO/screenshots are safe
        var dur = 1400, start = performance.now();
        function tick(now) {
          var p = Math.min(1, (now - start) / dur);
          var eased = 1 - Math.pow(1 - p, 3);
          var v = (target * eased).toFixed(decimals);
          el.innerHTML = v + suffix + emHTML;
          if (p < 1) requestAnimationFrame(tick);
          else el.innerHTML = target.toFixed(decimals) + suffix + emHTML;
        }
        requestAnimationFrame(tick);
      }

      // 4) Reveal-on-scroll
      if ('IntersectionObserver' in window) {
        var revealObs = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add('is-visible');
              revealObs.unobserve(en.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        document.querySelectorAll('.v2-glass .reveal').forEach(function (el) { revealObs.observe(el); });

        var statObs = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { animateCount(en.target); statObs.unobserve(en.target); }
          });
        }, { threshold: 0.4 });
        counters.forEach(function (el) { statObs.observe(el); });
      } else {
        document.querySelectorAll('.v2-glass .reveal').forEach(function (el) { el.classList.add('is-visible'); });
        counters.forEach(animateCount);
      }

      // 5) Nav scroll-state — toggles hairline border when page is scrolled
      var navWrap = document.querySelector('.v2-glass .nav-wrap');
      if (navWrap) {
        var navTick = false;
        function updateNav() {
          if (window.scrollY > 8) navWrap.setAttribute('data-scrolled', '');
          else navWrap.removeAttribute('data-scrolled');
          navTick = false;
        }
        window.addEventListener('scroll', function () {
          if (!navTick) { requestAnimationFrame(updateNav); navTick = true; }
        }, { passive: true });
        updateNav();
      }

      // 5b) Sample report bars — animate width from 0 to target on scroll-in
      var sampleBars = document.querySelectorAll('.v2-glass .g-mock-bar i[data-bar]');
      if (sampleBars.length && 'IntersectionObserver' in window) {
        // start at 0
        sampleBars.forEach(function (bar) { bar.style.width = '0%'; });
        var barObs = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              sampleBars.forEach(function (bar, i) {
                var target = bar.getAttribute('data-bar');
                setTimeout(function () { bar.style.width = target + '%'; }, i * 110);
              });
              barObs.disconnect();
            }
          });
        }, { threshold: 0.25 });
        var firstBar = sampleBars[0].closest('.g-sample-mock');
        if (firstBar) barObs.observe(firstBar);
      }

      // 6) Scroll progress bar (top)
      var progressBar = document.getElementById('scrollProgressBar');
      if (progressBar) {
        var pTick = false;
        function updateProgress() {
          var h = document.documentElement;
          var max = (h.scrollHeight - h.clientHeight) || 1;
          var pct = Math.min(100, Math.max(0, (h.scrollTop / max) * 100));
          progressBar.style.width = pct + '%';
          pTick = false;
        }
        window.addEventListener('scroll', function () {
          if (!pTick) { requestAnimationFrame(updateProgress); pTick = true; }
        }, { passive: true });
        updateProgress();
      }

      // 7a) Testimonials carousel — rotating image stack (21st.dev pattern, vanilla)
      (function () {
        var root = document.querySelector('.v2-glass [data-tc-root]');
        if (!root) return;
        var slides = Array.prototype.slice.call(root.querySelectorAll('[data-tc-slide]'));
        var texts = Array.prototype.slice.call(root.querySelectorAll('[data-tc-text]'));
        var prevBtn = root.querySelector('[data-tc-prev]');
        var nextBtn = root.querySelector('[data-tc-next]');
        var progress = root.querySelector('[data-tc-progress]');
        var total = slides.length;
        if (!total) return;
        var active = 0;
        var timer = null;
        var pad = function (n) { return n < 10 ? '0' + n : String(n); };
        function render() {
          for (var i = 0; i < total; i++) {
            slides[i].classList.remove('is-active', 'is-prev', 'is-next');
            if (i === active) slides[i].classList.add('is-active');
            else if (i === (active - 1 + total) % total) slides[i].classList.add('is-prev');
            else if (i === (active + 1) % total) slides[i].classList.add('is-next');
            texts[i].classList.toggle('is-active', i === active);
          }
          if (progress) progress.innerHTML = '<span class="is-current">' + pad(active + 1) + '</span> / ' + pad(total);
        }
        function go(dir) {
          active = (active + dir + total) % total;
          render();
          restart();
        }
        function start() { if (reduce) return; timer = setInterval(function () { go(1); }, 5500); }
        function restart() { if (timer) { clearInterval(timer); timer = null; } start(); }
        if (prevBtn) prevBtn.addEventListener('click', function () { go(-1); });
        if (nextBtn) nextBtn.addEventListener('click', function () { go(1); });
        root.addEventListener('mouseenter', function () { if (timer) { clearInterval(timer); timer = null; } });
        root.addEventListener('mouseleave', start);
        root.addEventListener('focusin', function () { if (timer) { clearInterval(timer); timer = null; } });
        root.addEventListener('focusout', start);
        // Keyboard nav when carousel has focus
        root.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowLeft') { go(-1); }
          else if (e.key === 'ArrowRight') { go(1); }
        });
        render();
        start();
      })();

      // 7) Scrollspy — highlight current section in nav
      var navAnchors = document.querySelectorAll('.v2-glass .nav-links a[href^="#"]');
      if (navAnchors.length && 'IntersectionObserver' in window) {
        var navMap = {};
        navAnchors.forEach(function (a) {
          var id = a.getAttribute('href').slice(1);
          if (id) navMap[id] = a;
        });
        var sectionEls = Object.keys(navMap).map(function (id) {
          return document.getElementById(id);
        }).filter(Boolean);
        function setActive(id) {
          navAnchors.forEach(function (a) { a.classList.remove('is-active'); });
          if (navMap[id]) navMap[id].classList.add('is-active');
        }
        var spyObs = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting && en.intersectionRatio > 0.25) {
              setActive(en.target.id);
            }
          });
        }, { rootMargin: '-30% 0px -55% 0px', threshold: [0.25, 0.5, 0.75] });
        sectionEls.forEach(function (s) { spyObs.observe(s); });
      }

      // 8) Lead form — inline validation + graceful submit + inline error/success
      var leadForm = document.getElementById('leadForm');
      var leadSuccess = document.getElementById('leadFormSuccess');
      var leadError = document.getElementById('leadFormError');
      if (leadForm) {
        var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        function fieldOf(input) { return input.closest('.g-field'); }
        function setError(input, msg) {
          var field = fieldOf(input);
          if (!field) return;
          var err = field.querySelector('.g-field-error');
          field.classList.add('has-error');
          if (err) err.textContent = msg;
        }
        function clearError(input) {
          var field = fieldOf(input);
          if (!field) return;
          field.classList.remove('has-error');
          var err = field.querySelector('.g-field-error');
          if (err) err.textContent = '';
        }
        function validateField(input, silent) {
          var v = (input.value || '').trim();
          var name = input.getAttribute('name');
          if (!v) {
            if (!silent) {
              var label = { name: 'Your name', email: 'Work email', company: 'Company' }[name] || 'This field';
              setError(input, label + ' is required.');
            }
            return false;
          }
          if (name === 'email' && !emailRe.test(v)) {
            setError(input, 'That email doesn\'t look right — check the format.');
            return false;
          }
          clearError(input);
          return true;
        }
        // Wire blur + input listeners on the 3 fields
        ['lead-name', 'lead-email', 'lead-company'].forEach(function (id) {
          var input = document.getElementById(id);
          if (!input) return;
          input.addEventListener('blur', function () { validateField(input, false); });
          input.addEventListener('input', function () {
            if (fieldOf(input).classList.contains('has-error')) validateField(input, true);
          });
        });

        leadForm.addEventListener('submit', function (e) {
          e.preventDefault();
          if (leadError) leadError.classList.remove('is-visible');

          // Validate all three fields before sending
          var inputs = [
            document.getElementById('lead-name'),
            document.getElementById('lead-email'),
            document.getElementById('lead-company')
          ];
          var ok = true, firstBad = null;
          inputs.forEach(function (input) {
            if (!validateField(input, false)) { ok = false; if (!firstBad) firstBad = input; }
          });
          if (!ok) { if (firstBad) firstBad.focus(); return; }

          var btn = leadForm.querySelector('button[type="submit"]');
          var orig = btn ? btn.innerHTML : '';
          if (btn) { btn.disabled = true; btn.innerHTML = 'Sending…'; }

          var data = new FormData(leadForm);
          var endpoint = leadForm.getAttribute('action');
          var useFetch = endpoint && endpoint.indexOf('your-form-id') === -1;

          function showSuccess() {
            leadForm.querySelectorAll('.g-field, .g-form-actions, .g-form-note').forEach(function (el) { el.style.display = 'none'; });
            if (leadSuccess) {
              leadSuccess.classList.add('is-visible');
              leadSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }
          function showError() {
            if (btn) { btn.disabled = false; btn.innerHTML = orig; }
            if (leadError) {
              leadError.classList.add('is-visible');
              leadError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }

          if (useFetch) {
            fetch(endpoint, { method: 'POST', body: data, headers: { 'Accept': 'application/json' } })
              .then(function (r) { if (r.ok) { showSuccess(); } else { throw new Error('Submit failed'); } })
              .catch(showError);
          } else {
            setTimeout(showSuccess, 420);
          }
        });
      }
    })();
  </script>

  <!-- Design Variants Footer (cross-variant navigation) -->
  <aside class="versions-strip" role="complementary" aria-label="Design variants navigation">
    <div class="vs-inner">
      <div class="vs-head">
        <span class="vs-label">Design Variants</span>
        <span class="vs-sep" aria-hidden="true">·</span>
        <span class="vs-meta">Seven directions for Anara Health · same content, different design language</span>
      </div>
      <nav class="vs-links" aria-label="All design variants">
        <a href="./anara-v1-bento.html" class="vs-link"><strong>01</strong> Bento Modular</a>
        <a href="./anara-v2-glass.html" class="vs-link"><strong>02</strong> Glassmorphism</a>
        <a href="./anara-v3-gradient.html" class="vs-link"><strong>03</strong> Gradient</a>
        <a href="./anara-v4-minimal.html" class="vs-link"><strong>04</strong> Minimal</a>
        <a href="./anara-v5-editorial.html" class="vs-link"><strong>05</strong> Editorial</a>
        <a href="./anara-v6-dark-luxury.html" class="vs-link"><strong>06</strong> Dark Luxury</a>
        <a href="./anara-v7-swiss.html" class="vs-link"><strong>07</strong> Swiss</a>
      </nav>
      <div class="vs-foot">
        <a href="./picker.html" class="vs-side">All variants overview ↗</a>
        <span class="vs-sep" aria-hidden="true">·</span>
        <a href="./anara.html" class="vs-side">Original homepage</a>
        <span class="vs-sep" aria-hidden="true">·</span>
        <a href="./header.html" class="vs-side">Hero comparison</a>
      </div>
    </div>
  </aside>
  <style>
    .versions-strip {
      background: #0A0A12;
      color: #F5F5F0;
      font-family: "Inter", system-ui, -apple-system, sans-serif;
      padding: 36px 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .versions-strip * {
      box-sizing: border-box;
    }

    .versions-strip .vs-inner {
      max-width: 1280px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .versions-strip .vs-head {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(245, 245, 240, 0.6);
    }

    .versions-strip .vs-label {
      color: #C9A56C;
      font-weight: 600;
    }

    .versions-strip .vs-meta {
      color: rgba(245, 245, 240, 0.55);
      font-weight: 500;
      text-transform: none;
      letter-spacing: 0.02em;
      font-size: 13px;
    }

    .versions-strip .vs-sep {
      color: rgba(245, 245, 240, 0.25);
    }

    .versions-strip .vs-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .versions-strip .vs-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: rgba(245, 245, 240, 0.85);
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: background .2s ease, border-color .2s ease, color .2s ease, transform .2s ease;
    }

    .versions-strip .vs-link strong {
      font-family: "Fraunces", Georgia, serif;
      font-size: 13px;
      font-weight: 600;
      color: rgba(245, 245, 240, 0.55);
    }

    .versions-strip .vs-link:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(201, 165, 108, 0.4);
      color: #F5F5F0;
      transform: translateY(-1px);
    }

    .versions-strip .vs-link:hover strong {
      color: #C9A56C;
    }

    .versions-strip .vs-link.current {
      background: #C9A56C;
      border-color: #C9A56C;
      color: #0A0A12;
    }

    .versions-strip .vs-link.current strong {
      color: #0A0A12;
    }

    .versions-strip .vs-foot {
      display: flex;
      gap: 12px;
      align-items: center;
      font-size: 13px;
      color: rgba(245, 245, 240, 0.55);
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      flex-wrap: wrap;
    }

    .versions-strip .vs-side {
      color: rgba(245, 245, 240, 0.78);
      border-bottom: 1px solid rgba(245, 245, 240, 0.2);
      padding-bottom: 1px;
      transition: color .2s ease, border-color .2s ease;
      text-decoration: none;
    }

    .versions-strip .vs-side:hover {
      color: #C9A56C;
      border-color: #C9A56C;
    }

    @media (max-width: 720px) {
      .versions-strip {
        padding: 28px 20px;
      }

      .versions-strip .vs-link {
        padding: 7px 12px;
        font-size: 12px;
      }

      .versions-strip .vs-link strong {
        font-size: 12px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .versions-strip .vs-link:hover {
        transform: none;
      }
    }
  </style>
  <script>
    (function () {
      var path = location.pathname.split('/').pop() || 'index.html';
      document.querySelectorAll('.versions-strip .vs-link, .versions-strip .vs-side').forEach(function (link) {
        var href = link.getAttribute('href').replace(/^\.\//, '');
        if (href === path) link.classList.add('current');
      });
    })();
  </script>
</body>

</html>