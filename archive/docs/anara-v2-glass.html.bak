<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#8E108C" />
  <title>Anara Health® — Corporate Healthcare for India's MNCs and GCCs</title>
  <meta name="description"
    content="Anara comes to your office, runs the health checks, and follows up with every employee on WhatsApp. 85%+ participation. No new budget line. Built for India's HR teams." />

  <meta property="og:type" content="website" />
  <meta property="og:title" content="Anara Health® — Corporate Healthcare for India's MNCs and GCCs" />
  <meta property="og:description"
    content="On-site clinics, every employee followed up on WhatsApp, population health reports your global HQ will respect." />
  <meta property="og:url" content="https://anara.health/" />
  <meta property="og:image" content="https://anara.health/og-cover.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Anara Health® — Corporate Healthcare for India's MNCs and GCCs" />
  <meta name="twitter:description"
    content="On-site clinics, every employee followed up on WhatsApp, population health reports your global HQ will respect." />

  <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 4 L28 26 H4 Z M11 26 L16 14 L21 26' fill='none' stroke='%238E108C' stroke-width='2.4' stroke-linejoin='round' stroke-linecap='round'/%3E%3C/svg%3E" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
  <link rel="stylesheet" href="anara.css" />
  <link rel="stylesheet" href="anara-v2.css" />
  <style>
    /* v2-glass — spec-driven extensions (PDF content spec, May 2026) */
    .brand-reg {
      font-size: 0.55em;
      font-weight: 600;
      vertical-align: super;
      line-height: 1;
      margin-left: 1px;
      opacity: 0.85;
    }

    .g-ticker-note {
      display: block;
      font-size: 0.82em;
      opacity: 0.78;
      font-weight: 500;
      margin-top: 2px;
      letter-spacing: 0.01em;
    }

    /* Founder Quote Break */
    .g-founder-break {
      padding: clamp(60px, 9vw, 110px) 0;
      position: relative;
    }

    .g-founder-quote {
      max-width: 920px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      padding: clamp(28px, 4vw, 48px) clamp(20px, 4vw, 56px);
    }

    .g-founder-quote {
      background: rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(22px) saturate(140%);
      -webkit-backdrop-filter: blur(22px) saturate(140%);
      border: 1px solid rgba(255, 255, 255, 0.65);
      border-radius: 28px;
      box-shadow: 0 24px 60px -28px rgba(36, 12, 52, 0.28);
    }

    .g-founder-mark {
      display: block;
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(72px, 9vw, 120px);
      line-height: 0.7;
      color: #8E108C;
      opacity: 0.35;
      margin-bottom: 4px;
    }

    .g-founder-quote blockquote {
      margin: 0;
    }

    .g-founder-quote blockquote p {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(20px, 2.1vw, 30px);
      line-height: 1.45;
      font-weight: 500;
      color: #2A0E3F;
      margin: 0 0 24px;
    }

    .g-founder-quote figcaption {
      display: flex;
      flex-direction: column;
      gap: 2px;
      align-items: center;
      font-size: 14px;
    }

    .g-founder-quote figcaption strong {
      font-weight: 600;
      color: #1D0A2F;
      letter-spacing: 0.01em;
    }

    .g-founder-quote figcaption span {
      color: rgba(29, 10, 47, 0.6);
      font-size: 13px;
    }

    /* Service package additions */
    .g-svc-tag {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #8E108C;
      background: rgba(142, 16, 140, 0.08);
      border: 1px solid rgba(142, 16, 140, 0.18);
      padding: 4px 10px;
      border-radius: 999px;
      margin-bottom: 14px;
    }

    .g-svc-yield {
      font-size: 13.5px;
      line-height: 1.55;
      color: rgba(20, 6, 36, 0.78);
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid rgba(20, 6, 36, 0.1);
    }

    .g-svc-yield strong {
      color: #1D0A2F;
    }

    /* Team — restructured to header + 6 cards + wide quote */
    .g-team-stack {
      display: flex;
      flex-direction: column;
      gap: clamp(32px, 4vw, 56px);
    }

    .g-team-head {
      max-width: 760px;
      margin: 0 auto;
      text-align: center;
    }

    .g-team-head .section-sub {
      margin-left: auto;
      margin-right: auto;
    }

    .g-team-roles {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .g-role-card {
      padding: clamp(20px, 2vw, 28px);
    }

    .g-role-card h3 {
      font-family: "Fraunces", Georgia, serif;
      font-size: 19px;
      font-weight: 600;
      margin: 0 0 10px;
      color: #fff;
      letter-spacing: -0.005em;
    }

    .g-role-card p {
      font-size: 14px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.78);
      margin: 0;
    }

    /* Leadership lockup */
    .g-leads {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .g-lead-card {
      padding: clamp(24px, 2.4vw, 32px);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .g-lead-card h3 {
      font-family: "Fraunces", Georgia, serif;
      font-size: 20px;
      font-weight: 600;
      margin: 0 0 4px;
      color: #fff;
    }

    .g-lead-card .g-lead-role {
      font-size: 12.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #C9A56C;
      font-weight: 600;
      margin: 0 0 8px;
    }

    .g-lead-card .g-lead-cred {
      font-size: 13.5px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.78);
      margin: 0;
    }

    .g-lead-card .g-lead-cred strong {
      color: #fff;
      font-weight: 600;
    }

    .g-lead-sub {
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.62);
      letter-spacing: 0.02em;
    }

    @media (max-width: 860px) {
      .g-leads {
        grid-template-columns: 1fr;
        max-width: 480px;
      }
    }

    /* Supporting team subheading */
    .g-team-subhead {
      text-align: center;
      max-width: 720px;
      margin: 0 auto;
    }

    .g-team-subhead .g-team-sub-eyebrow {
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.6);
      font-weight: 600;
    }

    .g-team-subhead h3 {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(22px, 2.2vw, 28px);
      font-weight: 500;
      color: #fff;
      margin: 8px 0 0;
      letter-spacing: -0.01em;
    }

    .g-team-quote-wide {
      max-width: 880px;
      margin: 0 auto;
      text-align: center;
      padding: clamp(28px, 4vw, 48px) clamp(22px, 4vw, 56px);
      display: flex;
      flex-direction: column;
      gap: 22px;
      align-items: center;
    }

    .g-team-quote-wide blockquote {
      margin: 0;
      max-width: 720px;
    }

    .g-team-quote-wide blockquote p {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(19px, 1.7vw, 24px);
      line-height: 1.5;
      color: #fff;
      margin: 0 0 16px;
      font-weight: 500;
    }

    .g-team-quote-wide blockquote footer {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.78);
    }

    @media (max-width: 960px) {
      .g-team-roles {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 600px) {
      .g-team-roles {
        grid-template-columns: 1fr;
      }
    }

    /* Leadership lockup — featured CEO + NDA aside (Hybrid D) */
    .g-leadership-lockup {
      display: grid;
      grid-template-columns: 1.45fr 1fr;
      gap: 18px;
      max-width: 1100px;
      margin: 0 auto;
      align-items: stretch;
    }

    .g-lead-featured {
      padding: clamp(28px, 3vw, 44px);
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: linear-gradient(180deg, rgba(142, 16, 140, 0.34) 0%, rgba(74, 11, 107, 0.34) 100%);
      border: 1px solid rgba(201, 165, 108, 0.32);
    }

    .g-lead-featured .g-lead-mark {
      width: 64px;
      height: 64px;
    }

    .g-lead-featured .g-lead-role {
      color: #C9A56C;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 600;
      margin: 0;
    }

    .g-lead-featured h3 {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(28px, 3vw, 36px);
      font-weight: 600;
      margin: 2px 0 6px;
      color: #fff;
      letter-spacing: -0.012em;
      line-height: 1.1;
    }

    .g-lead-featured .g-lead-cred {
      font-size: 15px;
      line-height: 1.65;
      color: rgba(255, 255, 255, 0.84);
      margin: 0;
    }

    .g-lead-featured .g-lead-signature {
      font-family: "Fraunces", Georgia, serif;
      font-style: italic;
      font-size: 16px;
      color: #fff;
      margin: 4px 0 0;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      line-height: 1.4;
    }

    .g-lead-featured .g-lead-cta {
      align-self: flex-start;
      margin-top: auto;
      padding-top: 6px;
    }

    .g-lead-aside {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .g-lead-strip {
      padding: clamp(20px, 2vw, 26px);
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }

    .g-lead-strip-role {
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #C9A56C;
      font-weight: 600;
      margin: 0;
    }

    .g-lead-strip h4 {
      font-family: "Fraunces", Georgia, serif;
      font-size: 17px;
      font-weight: 600;
      margin: 0;
      color: #fff;
      line-height: 1.3;
      letter-spacing: -0.005em;
    }

    .g-lead-strip p {
      font-size: 13.5px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.76);
      margin: 0;
    }

    .g-lead-strip .g-lead-nda {
      margin-top: auto;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #C9A56C;
      font-weight: 600;
      padding-top: 10px;
    }

    @media (max-width: 860px) {
      .g-leadership-lockup {
        grid-template-columns: 1fr;
        max-width: 520px;
      }
    }

    /* Supporting roles — roster variant (hairline dividers, no glass chrome) */
    .g-team-roles--roster {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      max-width: 1100px;
      margin: 0 auto;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 0;
    }

    .g-team-roles--roster .g-role-row {
      padding: clamp(22px, 2.4vw, 32px) clamp(18px, 2vw, 26px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
      border-right: 1px solid rgba(255, 255, 255, 0.16);
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: background-color 0.25s ease;
    }

    .g-team-roles--roster .g-role-row:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    .g-team-roles--roster .g-role-row:nth-child(3n) {
      border-right: none;
    }

    .g-team-roles--roster .g-role-row h3 {
      font-family: "Fraunces", Georgia, serif;
      font-size: 19px;
      font-weight: 600;
      color: #fff;
      margin: 0;
      letter-spacing: -0.005em;
    }

    .g-team-roles--roster .g-role-row p {
      font-size: 13.5px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.76);
      margin: 0;
    }

    @media (max-width: 960px) {
      .g-team-roles--roster {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .g-team-roles--roster .g-role-row:nth-child(3n) {
        border-right: 1px solid rgba(255, 255, 255, 0.16);
      }

      .g-team-roles--roster .g-role-row:nth-child(2n) {
        border-right: none;
      }
    }

    @media (max-width: 600px) {
      .g-team-roles--roster {
        grid-template-columns: 1fr;
      }

      .g-team-roles--roster .g-role-row {
        border-right: none !important;
      }
    }

    /* Testimonial monogram avatar */
    .g-t-mono {
      width: 48px;
      height: 48px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-family: "Fraunces", Georgia, serif;
      font-weight: 600;
      font-size: 16px;
      letter-spacing: 0.04em;
      background: linear-gradient(135deg, #8E108C 0%, #C9A56C 100%);
      color: #fff;
      flex-shrink: 0;
    }

    /* Footer platforms */
    .f-platforms {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin: 14px 0 16px;
      font-size: 13.5px;
    }

    .f-platforms a {
      color: rgba(255, 255, 255, 0.72);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .f-platforms a:hover {
      color: #C9A56C;
    }

    /* ─────────────────────────────────────────────────────────────────
       PREMIUM UPLIFT LAYER (UI/UX Pro Max + 21st Dev inspiration)
       Adds: scroll progress, hero pills, trust strip, comparison strip,
       sticky FAB, focus rings, hover polish, CTA shimmer.
       Respects prefers-reduced-motion.
       ───────────────────────────────────────────────────────────────── */

    /* Scroll progress bar (top, fixed) */
    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      z-index: 9999;
      pointer-events: none;
      background: rgba(20, 6, 36, 0.06);
    }

    .scroll-progress>i {
      display: block;
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, #8E108C 0%, #C9A56C 100%);
      transition: width 80ms linear;
      box-shadow: 0 0 12px rgba(142, 16, 140, 0.4);
    }

    @media (prefers-reduced-motion: reduce) {
      .scroll-progress>i {
        transition: none;
      }
    }

    /* Hero credential pills (above the fold) */
    .g-hero-creds {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 22px;
    }

    .g-hero-creds li {
      list-style: none;
    }

    .g-hero-creds span {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 13px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.65);
      font-size: 13px;
      font-weight: 500;
      color: #1D0A2F;
      letter-spacing: 0.01em;
    }

    .g-hero-creds svg {
      width: 14px;
      height: 14px;
      color: #8E108C;
      flex-shrink: 0;
    }

    /* Trust strip — industries served + cities + compliance */
    .g-trust-strip {
      padding: clamp(40px, 5vw, 64px) 0;
      border-top: 1px solid rgba(20, 6, 36, 0.06);
      border-bottom: 1px solid rgba(20, 6, 36, 0.06);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, rgba(252, 248, 255, 0.7) 100%);
    }

    .g-trust-inner {
      display: flex;
      flex-direction: column;
      gap: 22px;
      align-items: center;
      text-align: center;
    }

    .g-trust-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(29, 10, 47, 0.55);
    }

    .g-trust-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      max-width: 980px;
    }

    .g-trust-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(142, 16, 140, 0.12);
      font-size: 13px;
      font-weight: 500;
      color: #1D0A2F;
      transition: all 0.2s ease;
    }

    .g-trust-pill:hover {
      transform: translateY(-2px);
      border-color: rgba(142, 16, 140, 0.32);
      box-shadow: 0 6px 18px -8px rgba(142, 16, 140, 0.28);
    }

    .g-trust-pill svg {
      width: 14px;
      height: 14px;
      color: #8E108C;
    }

    .g-trust-pill strong {
      color: #8E108C;
      font-weight: 600;
    }

    .g-trust-divider {
      width: 1px;
      height: 18px;
      background: rgba(20, 6, 36, 0.12);
      margin: 0 4px;
      align-self: center;
    }

    @media (max-width: 720px) {
      .g-trust-divider {
        display: none;
      }
    }

    /* Comparison strip — Anara vs Traditional */
    .g-compare {
      padding: clamp(70px, 9vw, 120px) 0;
      position: relative;
    }

    .g-compare-card {
      max-width: 1100px;
      margin: 36px auto 0;
      border-radius: 28px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(24px) saturate(140%);
      -webkit-backdrop-filter: blur(24px) saturate(140%);
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow: 0 30px 80px -36px rgba(36, 12, 52, 0.28);
    }

    .g-compare-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      align-items: stretch;
    }

    .g-compare-grid>div {
      padding: 20px 24px;
      border-bottom: 1px solid rgba(20, 6, 36, 0.08);
    }

    .g-compare-grid>div:nth-last-child(-n+3) {
      border-bottom: none;
    }

    .g-compare-grid>div+div {
      border-left: 1px solid rgba(20, 6, 36, 0.06);
    }

    .g-compare-head {
      padding: 22px 24px !important;
      background: rgba(252, 248, 255, 0.5);
      font-weight: 600;
    }

    .g-compare-head.is-anara {
      background: linear-gradient(180deg, rgba(142, 16, 140, 0.92) 0%, rgba(108, 12, 105, 0.92) 100%);
      color: #fff;
      position: relative;
    }

    .g-compare-head.is-anara::before {
      content: "RECOMMENDED";
      position: absolute;
      top: -10px;
      right: 18px;
      font-size: 9px;
      letter-spacing: 0.16em;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
      background: #DF18DC;
      color: #1D0A2F;
    }

    .g-compare-label {
      font-size: 12px;
      color: rgba(29, 10, 47, 0.6);
      margin-bottom: 6px;
      letter-spacing: 0.04em;
      font-weight: 500;
    }

    .g-compare-row-label {
      font-family: "Fraunces", Georgia, serif;
      font-weight: 600;
      font-size: 16px;
      color: #1D0A2F;
    }

    .g-compare-row-label small {
      display: block;
      font-family: "Inter", sans-serif;
      font-weight: 400;
      font-size: 12.5px;
      color: rgba(29, 10, 47, 0.62);
      margin-top: 4px;
      letter-spacing: 0;
    }

    .g-compare-val {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14.5px;
      color: #1D0A2F;
      line-height: 1.5;
    }

    .g-compare-val.is-bad svg {
      color: #B91C1C;
    }

    .g-compare-val.is-good svg {
      color: #15803D;
    }

    .g-compare-val.is-anara {
      font-weight: 500;
      color: #1D0A2F;
    }

    .g-compare-val.is-anara strong {
      color: #8E108C;
      font-weight: 700;
    }

    .g-compare-val svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      margin-top: 3px;
    }

    @media (max-width: 760px) {
      .g-compare-grid {
        grid-template-columns: 1fr;
      }

      .g-compare-grid>div {
        border-left: none !important;
      }

      .g-compare-head {
        font-size: 14px;
      }

      .g-compare-head.is-anara::before {
        right: auto;
        left: 50%;
        transform: translateX(-50%);
        top: -10px;
      }
    }

    /* Sticky FAB cluster (WhatsApp + Schedule) */
    .g-fab {
      position: fixed;
      right: clamp(16px, 3vw, 28px);
      bottom: clamp(16px, 3vw, 28px);
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 950;
      align-items: flex-end;
    }

    .g-fab a {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 11px 18px 11px 14px;
      border-radius: 999px;
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: 0.01em;
      box-shadow: 0 12px 30px -8px rgba(36, 12, 52, 0.4);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .g-fab a:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 38px -10px rgba(36, 12, 52, 0.5);
    }

    .g-fab a:focus-visible {
      outline: 2px solid #C9A56C;
      outline-offset: 3px;
    }

    .g-fab-wa {
      background: #25D366;
      color: #fff;
    }

    .g-fab-call {
      background: linear-gradient(135deg, #8E108C 0%, #6C0C69 100%);
      color: #fff;
    }

    .g-fab svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .g-fab a span.g-fab-label {
      display: inline-block;
    }

    @media (max-width: 600px) {
      .g-fab a {
        padding: 11px 14px;
      }

      .g-fab a span.g-fab-label {
        display: none;
      }

      .g-fab a {
        width: 48px;
        height: 48px;
        justify-content: center;
      }
    }

    @media print {
      .g-fab {
        display: none;
      }
    }

    /* CTA premium polish — shimmer on primary, lift everywhere */
    .anara.v2-glass .btn {
      position: relative;
      overflow: hidden;
      transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease, background-color 0.22s ease, border-color 0.22s ease;
    }

    .anara.v2-glass .btn:hover {
      transform: translateY(-2px);
    }

    .anara.v2-glass .btn:active {
      transform: translateY(0);
      transition-duration: 0.08s;
    }

    .anara.v2-glass .btn-primary::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.32) 50%, transparent 70%);
      transform: translateX(-120%);
      transition: transform 0.6s ease;
      pointer-events: none;
    }

    .anara.v2-glass .btn-primary:hover::after {
      transform: translateX(120%);
    }

    @media (prefers-reduced-motion: reduce) {
      .anara.v2-glass .btn {
        transition: none;
      }

      .anara.v2-glass .btn:hover {
        transform: none;
      }

      .anara.v2-glass .btn-primary::after {
        display: none;
      }
    }

    /* Glass card focus-visible + hover lift (accessibility + premium) */
    .anara.v2-glass .g-glass-card {
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .anara.v2-glass .g-glass-card:focus-visible,
    .anara.v2-glass a.g-glass-card:focus-visible,
    .anara.v2-glass details.g-faq-item:focus-within {
      outline: 2px solid #C9A56C;
      outline-offset: 4px;
    }

    .anara.v2-glass a.g-glass-card:hover,
    .anara.v2-glass .g-service-card:hover {
      transform: translateY(-4px);
    }

    @media (prefers-reduced-motion: reduce) {
      .anara.v2-glass .g-glass-card {
        transition: none;
      }

      .anara.v2-glass a.g-glass-card:hover,
      .anara.v2-glass .g-service-card:hover {
        transform: none;
      }
    }

    /* Scrollspy active nav link */
    .anara.v2-glass .nav-links a.is-active {
      color: #8E108C;
      font-weight: 600;
    }

    .anara.v2-glass .nav-links a.is-active::after {
      content: "";
      display: block;
      width: 16px;
      height: 2px;
      background: linear-gradient(90deg, #8E108C, #C9A56C);
      border-radius: 2px;
      margin-top: 3px;
    }

    /* Smooth scroll across the page */
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 80px;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
    }

    /* Lead capture form (final CTA) */
    .g-lead-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin: 26px auto 0;
      max-width: 640px;
      text-align: left;
    }

    .g-lead-form .g-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .g-lead-form .g-field.full {
      grid-column: 1 / -1;
    }

    .g-lead-form label {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.85);
    }

    .g-lead-form label .req {
      color: #C9A56C;
      margin-left: 2px;
    }

    .g-lead-form input,
    .g-lead-form select {
      width: 100%;
      padding: 12px 14px;
      font-family: inherit;
      font-size: 15px;
      color: #1D0A2F;
      background: rgba(255, 255, 255, 0.94);
      border: 1px solid rgba(255, 255, 255, 0.4);
      border-radius: 12px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      min-height: 44px;
    }

    .g-lead-form input:focus,
    .g-lead-form select:focus {
      outline: none;
      border-color: #C9A56C;
      box-shadow: 0 0 0 3px rgba(201, 165, 108, 0.25);
    }

    .g-lead-form .g-form-actions {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: center;
      margin-top: 6px;
    }

    .g-lead-form .g-form-actions .btn {
      min-width: 200px;
    }

    .g-form-note {
      grid-column: 1 / -1;
      text-align: center;
      font-size: 12.5px;
      color: rgba(255, 255, 255, 0.72);
      margin-top: 4px;
    }

    .g-form-success {
      grid-column: 1 / -1;
      padding: 18px 22px;
      border-radius: 14px;
      background: rgba(21, 128, 61, 0.18);
      border: 1px solid rgba(120, 220, 150, 0.4);
      color: #fff;
      text-align: center;
      font-size: 15px;
      display: none;
    }

    .g-form-success.is-visible {
      display: block;
    }

    @media (max-width: 600px) {
      .g-lead-form {
        grid-template-columns: 1fr;
      }
    }

    /* Comparison strip body row */
    .g-compare-row-head {
      background: rgba(252, 248, 255, 0.4);
    }

    /* Pricing band */
    .g-pricing {
      padding: clamp(60px, 8vw, 100px) 0;
    }

    .g-pricing-card {
      max-width: 980px;
      margin: 0 auto;
      padding: clamp(28px, 4vw, 48px);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(22px) saturate(140%);
      -webkit-backdrop-filter: blur(22px) saturate(140%);
      border: 1px solid rgba(255, 255, 255, 0.65);
      box-shadow: 0 24px 60px -28px rgba(36, 12, 52, 0.28);
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(24px, 4vw, 48px);
      align-items: center;
    }

    .g-pricing-card h2 {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(24px, 2.6vw, 34px);
      color: #1D0A2F;
      margin: 0 0 12px;
      line-height: 1.2;
    }

    .g-pricing-card p {
      color: rgba(29, 10, 47, 0.78);
      font-size: 15px;
      line-height: 1.6;
      margin: 0 0 14px;
    }

    .g-pricing-figure {
      text-align: center;
      padding: clamp(22px, 3vw, 32px);
      border-radius: 22px;
      background: linear-gradient(160deg, rgba(142, 16, 140, 0.06) 0%, rgba(201, 165, 108, 0.08) 100%);
      border: 1px solid rgba(142, 16, 140, 0.12);
    }

    .g-pricing-figure .g-price-range {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(36px, 5vw, 52px);
      font-weight: 600;
      color: #8E108C;
      line-height: 1;
      letter-spacing: -0.01em;
    }

    .g-pricing-figure .g-price-unit {
      display: block;
      font-size: 14px;
      color: rgba(29, 10, 47, 0.7);
      margin-top: 8px;
      font-weight: 500;
    }

    .g-pricing-figure .g-price-fit {
      display: inline-block;
      margin-top: 14px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(142, 16, 140, 0.1);
      color: #8E108C;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .g-pricing-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .g-pricing-list li {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      font-size: 14.5px;
      line-height: 1.55;
      color: #1D0A2F;
    }

    .g-pricing-list svg {
      width: 18px;
      height: 18px;
      color: #15803D;
      flex-shrink: 0;
      margin-top: 2px;
    }

    @media (max-width: 760px) {
      .g-pricing-card {
        grid-template-columns: 1fr;
      }
    }

    /* Sample report visual */
    .g-sample-report {
      padding: clamp(60px, 8vw, 100px) 0;
    }

    .g-sample-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(28px, 4vw, 56px);
      align-items: center;
      max-width: 1100px;
      margin: 0 auto;
    }

    .g-sample-mock {
      padding: clamp(22px, 2.6vw, 34px);
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.78);
      backdrop-filter: blur(22px) saturate(140%);
      -webkit-backdrop-filter: blur(22px) saturate(140%);
      border: 1px solid rgba(255, 255, 255, 0.65);
      box-shadow: 0 30px 70px -34px rgba(36, 12, 52, 0.32);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .g-sample-mock .g-mock-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(20, 6, 36, 0.08);
      gap: 12px;
      flex-wrap: wrap;
    }

    .g-sample-mock .g-mock-head .g-mock-title {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .g-sample-mock .g-mock-head .g-mock-title strong {
      font-family: "Fraunces", Georgia, serif;
      font-size: 17px;
      color: #1D0A2F;
      font-weight: 600;
    }

    .g-sample-mock .g-mock-head .g-mock-title small {
      font-size: 12px;
      color: rgba(29, 10, 47, 0.62);
    }

    .g-sample-mock .g-mock-head .g-mock-meta {
      display: flex;
      flex-direction: column;
      gap: 3px;
      text-align: right;
    }

    .g-sample-mock .g-mock-head .g-mock-meta span {
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(29, 10, 47, 0.55);
      font-weight: 600;
    }

    .g-sample-mock .g-mock-head .g-mock-meta strong {
      font-size: 12.5px;
      color: #8E108C;
      font-weight: 700;
    }

    .g-mock-axis {
      display: flex;
      justify-content: space-between;
      font-size: 10.5px;
      letter-spacing: 0.06em;
      color: rgba(29, 10, 47, 0.5);
      font-weight: 600;
      text-transform: uppercase;
      padding: 0 134px 0 0;
      margin-top: 2px;
    }

    .g-mock-axis span {
      flex: 1;
      text-align: center;
    }

    .g-mock-axis span:first-child {
      text-align: left;
    }

    .g-mock-axis span:last-child {
      text-align: right;
    }

    .g-mock-rows {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .g-mock-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .g-mock-row .g-mock-label {
      font-size: 13px;
      color: rgba(29, 10, 47, 0.82);
      flex-shrink: 0;
      min-width: 134px;
      font-weight: 500;
    }

    .g-mock-bar {
      flex: 1;
      height: 9px;
      border-radius: 999px;
      background: rgba(20, 6, 36, 0.06);
      overflow: visible;
      position: relative;
    }

    .g-mock-bar i {
      display: block;
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #8E108C 0%, #C9A56C 100%);
      position: relative;
    }

    .g-mock-bar.is-warn i {
      background: linear-gradient(90deg, #B91C1C 0%, #E89A3F 100%);
    }

    .g-mock-bar.is-good i {
      background: linear-gradient(90deg, #15803D 0%, #4FB37A 100%);
    }

    .g-mock-bar .g-mock-bench {
      position: absolute;
      top: -4px;
      bottom: -4px;
      width: 2px;
      background: rgba(29, 10, 47, 0.32);
      border-radius: 2px;
      pointer-events: none;
    }

    .g-mock-bar .g-mock-bench::after {
      content: attr(data-label);
      position: absolute;
      top: -16px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 9.5px;
      color: rgba(29, 10, 47, 0.55);
      font-weight: 600;
      white-space: nowrap;
      letter-spacing: 0.04em;
    }

    .g-mock-meta-right {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 92px;
      justify-content: flex-end;
    }

    .g-mock-pct {
      font-family: "Fraunces", Georgia, serif;
      font-size: 15px;
      font-weight: 600;
      color: #1D0A2F;
      min-width: 44px;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .g-mock-delta {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 999px;
      letter-spacing: 0.02em;
      font-variant-numeric: tabular-nums;
    }

    .g-mock-delta.is-up-good {
      background: rgba(21, 128, 61, 0.12);
      color: #15803D;
    }

    .g-mock-delta.is-down-good {
      background: rgba(21, 128, 61, 0.12);
      color: #15803D;
    }

    .g-mock-delta.is-up-bad {
      background: rgba(185, 28, 28, 0.12);
      color: #B91C1C;
    }

    .g-mock-delta.is-flat {
      background: rgba(20, 6, 36, 0.08);
      color: rgba(29, 10, 47, 0.62);
    }

    .g-mock-legend {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      font-size: 11.5px;
      color: rgba(29, 10, 47, 0.62);
      margin-top: 6px;
      padding-top: 10px;
      border-top: 1px solid rgba(20, 6, 36, 0.06);
    }

    .g-mock-legend span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .g-mock-legend i {
      width: 14px;
      height: 2px;
      background: rgba(29, 10, 47, 0.32);
      display: inline-block;
      border-radius: 2px;
    }

    .g-mock-footnote {
      font-size: 11.5px;
      color: rgba(29, 10, 47, 0.55);
      margin-top: 4px;
      line-height: 1.5;
    }

    @media (max-width: 720px) {
      .g-mock-axis {
        padding-right: 0;
        display: none;
      }

      .g-mock-meta-right {
        min-width: 72px;
        gap: 6px;
      }

      .g-mock-delta {
        display: none;
      }
    }

    /* What we don't do */
    .g-not {
      padding: clamp(60px, 8vw, 100px) 0;
    }

    .g-not-card {
      max-width: 980px;
      margin: 0 auto;
      padding: clamp(28px, 4vw, 48px);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(22px) saturate(140%);
      -webkit-backdrop-filter: blur(22px) saturate(140%);
      border: 1px solid rgba(255, 255, 255, 0.65);
      box-shadow: 0 24px 60px -28px rgba(36, 12, 52, 0.28);
    }

    .g-not-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 28px;
      margin-top: 22px;
    }

    .g-not-grid li {
      list-style: none;
      display: flex;
      gap: 12px;
      align-items: flex-start;
      font-size: 14.5px;
      line-height: 1.55;
      color: #1D0A2F;
    }

    .g-not-grid li strong {
      display: block;
      font-family: "Fraunces", Georgia, serif;
      font-size: 15.5px;
      color: #1D0A2F;
      margin-bottom: 3px;
    }

    .g-not-grid li span {
      color: rgba(29, 10, 47, 0.72);
      font-size: 13.5px;
    }

    .g-not-grid svg {
      width: 20px;
      height: 20px;
      color: rgba(29, 10, 47, 0.5);
      flex-shrink: 0;
      margin-top: 2px;
    }

    @media (max-width: 720px) {
      .g-not-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Process step connectors */
    .anara.v2-glass .g-process-grid {
      position: relative;
    }

    .anara.v2-glass .g-step {
      position: relative;
    }

    .anara.v2-glass .g-step::after {
      content: "";
      position: absolute;
      top: 50%;
      right: -28px;
      width: 16px;
      height: 2px;
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.6) 0%, rgba(201, 165, 108, 0.95) 100%);
      transform: translateY(-50%);
      pointer-events: none;
      z-index: 2;
    }

    .anara.v2-glass .g-step::before {
      content: "";
      position: absolute;
      top: 50%;
      right: -32px;
      width: 0;
      height: 0;
      border-left: 8px solid #C9A56C;
      border-top: 6px solid transparent;
      border-bottom: 6px solid transparent;
      transform: translateY(-50%);
      pointer-events: none;
      z-index: 2;
    }

    .anara.v2-glass .g-step:last-child::after,
    .anara.v2-glass .g-step:last-child::before {
      display: none;
    }

    @media (max-width: 980px) {

      .anara.v2-glass .g-step::after,
      .anara.v2-glass .g-step::before {
        display: none;
      }
    }

    /* Pulsing dot in hero trust indicator */
    .anara.v2-glass .g-trust .dot {
      position: relative;
    }

    .anara.v2-glass .g-trust .dot::after {
      content: "";
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.35;
      animation: g-pulse 2.2s ease-out infinite;
    }

    @keyframes g-pulse {
      0% {
        transform: scale(1);
        opacity: 0.35;
      }

      70% {
        transform: scale(2);
        opacity: 0;
      }

      100% {
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .anara.v2-glass .g-trust .dot::after {
        animation: none;
      }
    }

    /* ─────────────────────────────────────────────────────────────────
       PREMIUM 10/10 UPLIFT — Typography, hierarchy, contrast, glass
       Token-driven. Overrides defaults from anara-v2.css where needed.
       ───────────────────────────────────────────────────────────────── */

    .anara.v2-glass {
      /* Semantic text tokens — WCAG AAA on white, AA+ on glass */
      --t-ink: #14062B;
      /* primary heading on light */
      --t-ink-soft: #2E1A47;
      /* primary body on light */
      --t-ink-muted: #4A3960;
      /* secondary/muted on light, ~7.5:1 */
      --t-ink-quiet: #6B5C82;
      /* tertiary/eyebrow, ~4.7:1 */
      --t-onpurple: #FFFFFF;
      --t-onpurple-soft: rgba(255, 255, 255, 0.92);
      --t-onpurple-muted: rgba(255, 255, 255, 0.78);
      /* AA on accent-dark */
      --t-gold: #C9A56C;
      --t-accent: #8E108C;

      /* Type scale — single rhythm */
      --fs-display: clamp(38px, 5vw, 64px);
      /* hero H1 */
      --fs-h2: clamp(30px, 3.6vw, 46px);
      /* section H2 — unified */
      --fs-h2-sm: clamp(24px, 2.6vw, 32px);
      /* sub-H2 inside cards */
      --fs-h3: 20px;
      /* card H3 — unified */
      --fs-h3-lg: 22px;
      /* feature card H3 */
      --fs-body: 16px;
      --fs-body-sm: 15px;
      --fs-meta: 13px;
      --fs-eyebrow: 12px;

      /* Glass surfaces — opacity by background context */
      --glass-on-dark: rgba(255, 255, 255, 0.88);
      --glass-on-mesh: rgba(255, 255, 255, 0.62);
      --glass-on-light: rgba(255, 255, 255, 0.55);
      --glass-onpurple: rgba(255, 255, 255, 0.10);
    }

    /* HIERARCHY — section-head H2 unified across the page */
    .anara.v2-glass .section-head h2 {
      font-size: var(--fs-h2);
      line-height: 1.08;
      letter-spacing: -0.025em;
      color: var(--t-ink);
      font-weight: 500;
    }

    .anara.v2-glass .section-head .section-sub {
      font-size: 16.5px;
      line-height: 1.6;
      color: var(--t-ink-muted);
      max-width: 62ch;
      margin-left: auto;
      margin-right: auto;
    }

    .anara.v2-glass .eyebrow {
      font-size: var(--fs-eyebrow);
      letter-spacing: 0.2em;
      font-weight: 700;
      color: var(--t-accent);
      margin-bottom: 14px;
    }

    .anara.v2-glass .g-section-head-light .eyebrow {
      color: #F2D6F2;
    }

    .anara.v2-glass .g-section-head-light .section-sub {
      color: var(--t-onpurple-soft);
    }

    /* Card H3 unified */
    .anara.v2-glass .g-why-grid h3,
    .anara.v2-glass .g-service-card h3,
    .anara.v2-glass .g-p-card h3,
    .anara.v2-glass .g-step h3,
    .anara.v2-glass .g-role-card h3,
    .anara.v2-glass .g-lead-card h3 {
      font-size: var(--fs-h3-lg);
      line-height: 1.25;
      letter-spacing: -0.015em;
      font-weight: 600;
    }

    .anara.v2-glass .g-caption h3 {
      font-size: 17px;
      letter-spacing: -0.01em;
      font-weight: 600;
    }

    /* BODY text inside glass cards — boost contrast */
    .anara.v2-glass .g-why-grid p,
    .anara.v2-glass .g-service-card p,
    .anara.v2-glass .g-p-card p,
    .anara.v2-glass .g-step p,
    .anara.v2-glass .g-glass-card>p,
    .anara.v2-glass .g-about-glass p,
    .anara.v2-glass .g-about-glass .muted {
      color: var(--t-ink-soft);
    }

    .anara.v2-glass .g-svc-yield {
      color: var(--t-ink-muted);
    }

    .anara.v2-glass .g-svc-yield strong {
      color: var(--t-ink);
    }

    /* ROLE / LEAD cards on dark — bump contrast */
    .anara.v2-glass .g-role-card p {
      color: var(--t-onpurple-soft);
      font-size: 14.5px;
      line-height: 1.6;
    }

    .anara.v2-glass .g-lead-card .g-lead-cred {
      color: var(--t-onpurple-soft);
      font-size: 14px;
    }

    .anara.v2-glass .g-lead-sub {
      color: var(--t-onpurple-muted);
    }

    /* GLASS — context-aware opacity. Stronger blur on lavender so cards float */
    .anara.v2-glass .g-why-grid .g-glass-card,
    .anara.v2-glass .g-principle-grid .g-p-card,
    .anara.v2-glass .g-gallery .g-caption,
    .anara.v2-glass .g-faq .g-faq-item,
    .anara.v2-glass .g-testimonials .g-t-card:not(.g-t-feature) {
      background: var(--glass-on-light);
      backdrop-filter: blur(28px) saturate(160%);
      -webkit-backdrop-filter: blur(28px) saturate(160%);
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow: 0 20px 50px -20px rgba(36, 12, 52, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    }

    /* Ambient mesh wash behind lavender sections — gives backdrop-filter something to blur */
    .anara.v2-glass .g-why,
    .anara.v2-glass .g-principles,
    .anara.v2-glass .g-gallery,
    .anara.v2-glass .g-testimonials,
    .anara.v2-glass .g-faq {
      position: relative;
      isolation: isolate;
    }

    .anara.v2-glass .g-why::before,
    .anara.v2-glass .g-principles::before,
    .anara.v2-glass .g-gallery::before,
    .anara.v2-glass .g-testimonials::before,
    .anara.v2-glass .g-faq::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(60% 50% at 12% 18%, rgba(166, 46, 226, 0.10), transparent 60%),
        radial-gradient(50% 45% at 88% 82%, rgba(201, 165, 108, 0.10), transparent 60%),
        radial-gradient(40% 40% at 50% 50%, rgba(143, 16, 140, 0.06), transparent 70%);
    }

    /* SERVICE & PRINCIPLE icons — recolor pastel pink → brand */
    .anara.v2-glass .g-service-icon,
    .anara.v2-glass .g-p-icon {
      background: linear-gradient(135deg, rgba(142, 16, 140, 0.12) 0%, rgba(201, 165, 108, 0.18) 100%);
      color: var(--t-accent);
      box-shadow: inset 0 0 0 1px rgba(142, 16, 140, 0.22);
    }

    .anara.v2-glass .g-service-card:hover .g-service-icon {
      background: linear-gradient(135deg, rgba(142, 16, 140, 0.92) 0%, rgba(108, 12, 105, 0.92) 100%);
      color: #fff;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3), 0 12px 28px rgba(142, 16, 140, 0.32);
    }

    /* SERVICE card — restructure tag as corner chip, fix hierarchy */
    .anara.v2-glass .g-service-card {
      padding: 36px 30px 30px;
    }

    .anara.v2-glass .g-service-card .g-svc-tag {
      position: absolute;
      top: 22px;
      right: 70px;
      margin: 0;
      font-size: 10.5px;
      letter-spacing: 0.16em;
      padding: 5px 10px;
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(142, 16, 140, 0.22);
    }

    .anara.v2-glass .g-service-card h3 {
      font-size: var(--fs-h3-lg);
      margin: 6px 0 10px;
      max-width: 24ch;
    }

    .anara.v2-glass .g-service-card p {
      font-size: var(--fs-body-sm);
      line-height: 1.6;
      max-width: 44ch;
    }

    /* HERO paragraph rebalance (H1 rules consolidated in Layer 2 below) */
    .anara.v2-glass .g-hero-glass p {
      font-size: 17px;
      line-height: 1.6;
      color: var(--t-ink-soft);
      max-width: 48ch;
    }

    .anara.v2-glass .g-trust {
      color: var(--t-ink-muted);
    }

    /* TICKER text contrast bump */
    .anara.v2-glass .g-ticker-inner dd {
      color: rgba(255, 255, 255, 0.86);
    }

    .anara.v2-glass .g-ticker-note {
      opacity: 0.86;
    }

    /* COMPARISON cells — boost contrast + tabular alignment */
    .anara.v2-glass .g-compare-val {
      color: var(--t-ink-soft);
      font-size: 14.5px;
    }

    .anara.v2-glass .g-compare-val.is-bad {
      color: var(--t-ink-muted);
    }

    .anara.v2-glass .g-compare-val.is-bad svg {
      color: #6B5C82;
    }

    /* neutral, not preachy red */
    .anara.v2-glass .g-compare-row-label {
      color: var(--t-ink);
    }

    .anara.v2-glass .g-compare-row-label small {
      color: var(--t-ink-muted);
    }

    /* "WHAT WE DON'T DO" — proper H2 size, classed copy (no inline) */
    .anara.v2-glass .g-not-card .section-head {
      text-align: left;
      margin: 0 0 8px;
    }

    .anara.v2-glass .g-not-card .section-head h2 {
      font-size: var(--fs-h2-sm);
      margin: 4px 0 8px;
    }

    .anara.v2-glass .g-not-card .section-head .section-sub {
      margin: 0;
      max-width: 720px;
    }

    .anara.v2-glass .g-not-grid li strong {
      color: var(--t-ink);
    }

    .anara.v2-glass .g-not-grid li span {
      color: var(--t-ink-muted);
      font-size: 14px;
      line-height: 1.55;
    }

    /* PRICING — promote sub-H2 to H3 size visually */
    .anara.v2-glass .g-pricing-card .g-pricing-sub {
      font-family: "Fraunces", Georgia, serif;
      font-size: var(--fs-h2-sm);
      color: var(--t-ink);
      margin: 0 0 12px;
      line-height: 1.2;
      font-weight: 600;
    }

    .anara.v2-glass .g-pricing-card p {
      color: var(--t-ink-soft);
    }

    .anara.v2-glass .g-pricing-list li {
      color: var(--t-ink-soft);
    }

    /* SAMPLE REPORT side-copy — class instead of inline */
    .anara.v2-glass .g-sample-copy h3 {
      font-family: "Fraunces", Georgia, serif;
      font-size: var(--fs-h2-sm);
      color: var(--t-ink);
      margin: 0 0 14px;
      line-height: 1.2;
      font-weight: 600;
      letter-spacing: -0.015em;
    }

    .anara.v2-glass .g-sample-copy p {
      font-size: var(--fs-body-sm);
      line-height: 1.65;
      color: var(--t-ink-soft);
      margin: 0 0 14px;
    }

    .anara.v2-glass .g-sample-copy p:last-of-type {
      margin-bottom: 22px;
    }

    .anara.v2-glass .g-mock-footnote {
      color: var(--t-ink-quiet);
    }

    /* LEAD FORM — better contrast on purple mesh */
    .anara.v2-glass .g-lead-form label {
      color: #FFFFFF;
    }

    .anara.v2-glass .g-form-note {
      color: rgba(255, 255, 255, 0.86);
      font-size: 13px;
    }

    .anara.v2-glass .g-form-note a {
      color: var(--t-gold);
    }

    /* LEADERSHIP cards — premium symbol-mark in place of initials */
    .anara.v2-glass .g-lead-mark {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(142, 16, 140, 0.92), rgba(74, 11, 107, 0.92));
      color: #fff;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18), 0 12px 28px -10px rgba(142, 16, 140, 0.5);
      flex-shrink: 0;
    }

    .anara.v2-glass .g-lead-mark svg {
      width: 26px;
      height: 26px;
    }

    .anara.v2-glass .g-lead-card {
      gap: 10px;
    }

    .anara.v2-glass .g-lead-card .g-lead-role {
      margin: 6px 0 4px;
    }

    .anara.v2-glass .g-lead-card .g-lead-nda {
      display: inline-block;
      margin-top: 8px;
      font-size: 11.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--t-gold);
      font-weight: 600;
    }

    /* TESTIMONIAL monogram — keep monogram but use brand color, not flashy gradient */
    .anara.v2-glass .g-t-mono {
      background: linear-gradient(135deg, #2E1A47 0%, #8E108C 100%);
    }

    /* FAQ — make summary text fully readable */
    .anara.v2-glass .g-faq-item summary {
      color: var(--t-ink);
      font-weight: 500;
    }

    .anara.v2-glass .g-faq-body p {
      color: var(--t-ink-soft);
    }

    /* FOUNDER QUOTE — bigger pull, tighter caption */
    .anara.v2-glass .g-founder-quote blockquote p {
      color: var(--t-ink);
      font-weight: 500;
    }

    .anara.v2-glass .g-founder-quote figcaption strong {
      color: var(--t-ink);
    }

    .anara.v2-glass .g-founder-quote figcaption span {
      color: var(--t-ink-quiet);
    }

    /* TRUST STRIP — readability */
    .anara.v2-glass .g-trust-label {
      color: var(--t-ink-quiet);
    }

    .anara.v2-glass .g-trust-pill {
      color: var(--t-ink-soft);
    }

    /* MISSION & ABOUT — about heading scale */
    .anara.v2-glass .g-about-glass h2 {
      font-size: var(--fs-h2-sm);
      line-height: 1.12;
      letter-spacing: -0.02em;
      color: var(--t-ink);
      font-weight: 500;
    }

    /* CTA card on mesh — readable */
    .anara.v2-glass .g-cta-glass h2 {
      color: #fff;
      font-weight: 500;
      letter-spacing: -0.025em;
    }

    .anara.v2-glass .g-cta-glass>p {
      color: var(--t-onpurple-soft);
    }

    /* GALLERY caption legibility */
    .anara.v2-glass .g-caption p {
      color: var(--t-ink-soft);
      font-size: 12.5px;
    }

    /* ─────────────────────────────────────────────────────────────────
       LAYER 2 — Section-by-section polish to 10/10
       ───────────────────────────────────────────────────────────────── */

    /* HERO — canonical H1 rule (consolidated from Layer 1 + base) */
    .anara.v2-glass .g-hero-glass h1 {
      font-size: clamp(36px, 4.6vw, 60px);
      line-height: 1.06;
      letter-spacing: -0.032em;
      font-weight: 500;
      max-width: 22ch;
      margin: 0 0 18px;
    }

    /* Credentials now sit between paragraph and CTA — calm, secondary trust signals */
    .anara.v2-glass .g-hero-creds {
      margin: 4px 0 22px;
      gap: 8px;
    }

    .anara.v2-glass .g-hero-creds span {
      padding: 7px 12px;
      font-size: 12px;
      background: rgba(255, 255, 255, 0.6);
    }

    /* CTA is the visual anchor — primary button gets emphasis */
    .anara.v2-glass .g-hero-glass .g-cta {
      margin-top: 0;
      gap: 14px;
    }

    .anara.v2-glass .g-hero-glass .g-cta .btn-primary {
      padding: 14px 24px;
      font-size: 15.5px;
      font-weight: 600;
    }

    .anara.v2-glass .g-hero-glass .g-cta .btn-outline {
      padding: 14px 22px;
      font-size: 14.5px;
    }

    .anara.v2-glass .g-ticker-inner strong {
      font-size: clamp(26px, 2.4vw, 36px);
    }

    .anara.v2-glass .g-ticker-inner dd {
      font-size: 11.5px;
      letter-spacing: 0.08em;
      margin-top: 4px;
    }

    .anara.v2-glass .g-ticker-note {
      font-size: 0.7em;
      opacity: 0.7;
      margin-top: 1px;
    }

    /* HERO right-side credential strip — fills dead space, adds anchor */
    .anara.v2-glass .g-hero-side {
      position: absolute;
      right: clamp(24px, 4vw, 56px);
      top: clamp(120px, 16vh, 200px);
      z-index: 3;
      display: flex;
      flex-direction: column;
      gap: 14px;
      max-width: 240px;
    }

    .anara.v2-glass .g-hero-side-card {
      padding: 18px 20px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(18px) saturate(160%);
      -webkit-backdrop-filter: blur(18px) saturate(160%);
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: #fff;
      box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.4);
    }

    .anara.v2-glass .g-hero-side-card strong {
      font-family: "Fraunces", Georgia, serif;
      font-size: 26px;
      font-weight: 500;
      letter-spacing: -0.01em;
      display: block;
      line-height: 1;
      margin-bottom: 6px;
      color: var(--t-gold);
    }

    .anara.v2-glass .g-hero-side-card span {
      font-size: 12px;
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.86);
      display: block;
    }

    @media (max-width: 1100px) {
      .anara.v2-glass .g-hero-side {
        display: none;
      }
    }

    /* TRUST STRIP — divider between rows, weight differentiation */
    .anara.v2-glass .g-trust-strip {
      padding: clamp(48px, 6vw, 80px) 0;
    }

    .anara.v2-glass .g-trust-inner {
      gap: 28px;
    }

    .anara.v2-glass .g-trust-inner .g-trust-row:nth-of-type(2) {
      padding-top: 22px;
      border-top: 1px solid rgba(20, 6, 36, 0.08);
    }

    .anara.v2-glass .g-trust-row:nth-of-type(1) .g-trust-pill {
      background: rgba(142, 16, 140, 0.06);
      border-color: rgba(142, 16, 140, 0.22);
      font-weight: 600;
    }

    .anara.v2-glass .g-trust-row:nth-of-type(2) .g-trust-pill {
      background: transparent;
      border-color: rgba(20, 6, 36, 0.15);
      font-weight: 500;
      padding: 7px 13px;
    }

    .anara.v2-glass .g-trust-row:nth-of-type(2) .g-trust-pill strong {
      color: var(--t-accent);
    }

    /* ABOUT — badge top-right with halo */
    .anara.v2-glass .g-about-stat {
      top: 22px;
      left: auto;
      right: 22px;
      bottom: auto;
      padding: 18px 24px;
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.95);
      box-shadow: 0 20px 50px rgba(26, 11, 38, 0.28), 0 0 0 8px rgba(255, 255, 255, 0.18);
    }

    .anara.v2-glass .g-about-stat strong {
      font-size: 36px;
      color: var(--t-accent);
    }

    .anara.v2-glass .g-about-stat span {
      font-size: 11.5px;
      letter-spacing: 0.04em;
      color: var(--t-ink-muted);
    }

    .anara.v2-glass .g-about-glass {
      padding: 48px;
    }

    .anara.v2-glass .g-about-glass h2 {
      max-width: 26ch;
    }

    /* WHY — promote numerals, feature card 01 */
    .anara.v2-glass .g-why-grid .num {
      font-family: "Fraunces", Georgia, serif;
      font-weight: 500;
      font-size: 32px;
      letter-spacing: -0.01em;
      background: linear-gradient(135deg, var(--t-accent), var(--t-gold));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 4px;
    }

    .anara.v2-glass .g-why-grid .g-glass-card {
      min-height: 240px;
    }

    .anara.v2-glass .g-why-grid .g-glass-card.is-feature {
      background: linear-gradient(180deg, rgba(142, 16, 140, 0.96) 0%, rgba(74, 11, 107, 0.96) 100%);
      border-color: rgba(255, 255, 255, 0.22);
      color: #fff;
      box-shadow: 0 30px 70px -20px rgba(142, 16, 140, 0.45);
    }

    .anara.v2-glass .g-why-grid .g-glass-card.is-feature .num {
      background: linear-gradient(135deg, #FFF, var(--t-gold));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .anara.v2-glass .g-why-grid .g-glass-card.is-feature h3 {
      color: #fff;
    }

    .anara.v2-glass .g-why-grid .g-glass-card.is-feature p {
      color: rgba(255, 255, 255, 0.9);
    }

    /* COMPARISON — alternating rows, scan rhythm, bigger RECOMMENDED */
    .anara.v2-glass .g-compare-grid {
      grid-template-columns: 1.3fr 1fr 1fr;
    }

    .anara.v2-glass .g-compare-row-head {
      background: rgba(252, 248, 255, 0.55);
    }

    .anara.v2-glass .g-compare-grid>.g-compare-row-head+.g-compare-val,
    .anara.v2-glass .g-compare-grid>.g-compare-row-head+.g-compare-val+.g-compare-val {
      background: rgba(252, 248, 255, 0.55);
    }

    .anara.v2-glass .g-compare-head.is-anara::before {
      font-size: 10.5px;
      padding: 5px 12px;
      top: -11px;
      box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.5), 0 6px 14px rgba(142, 16, 140, 0.32);
    }

    .anara.v2-glass .g-compare-row-label {
      font-size: 16.5px;
    }

    .anara.v2-glass .g-compare-row-label small {
      font-size: 12px;
      margin-top: 5px;
    }

    /* FOUNDER QUOTE — tinted band, tighter mark, bolder caption */
    .anara.v2-glass .g-founder-break {
      background: linear-gradient(180deg, transparent 0%, rgba(142, 16, 140, 0.05) 40%, rgba(201, 165, 108, 0.05) 60%, transparent 100%);
    }

    .anara.v2-glass .g-founder-mark {
      margin-bottom: -32px;
      line-height: 0.7;
      position: relative;
      z-index: 0;
    }

    .anara.v2-glass .g-founder-quote blockquote p {
      position: relative;
      z-index: 1;
    }

    .anara.v2-glass .g-founder-quote figcaption strong {
      font-size: 15px;
    }

    .anara.v2-glass .g-founder-quote figcaption span {
      font-size: 13.5px;
      color: var(--t-gold);
      font-weight: 500;
      letter-spacing: 0.04em;
    }

    /* SERVICES — split tier from package tag, shrink + reposition arrow */
    .anara.v2-glass .g-service-card .g-svc-tier {
      display: inline-block;
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--t-gold);
      margin-left: 10px;
      padding: 4px 10px;
      background: rgba(201, 165, 108, 0.12);
      border: 1px solid rgba(201, 165, 108, 0.32);
      border-radius: 999px;
      vertical-align: middle;
    }

    .anara.v2-glass .g-service-card .g-svc-tag {
      right: 26px;
      top: 26px;
    }

    .anara.v2-glass .g-service-card .arrow {
      right: 26px;
      bottom: 24px;
      top: auto;
      width: 32px;
      height: 32px;
      font-size: 14px;
    }

    .anara.v2-glass .g-service-card {
      padding-bottom: 64px;
    }

    /* PRICING — bold first 2 bullets, integrate price block, promote OPD chip */
    .anara.v2-glass .g-pricing-card {
      border: 1px solid rgba(142, 16, 140, 0.18);
    }

    .anara.v2-glass .g-pricing-list li:nth-child(-n+2) {
      font-weight: 600;
      font-size: 15px;
      color: var(--t-ink);
    }

    .anara.v2-glass .g-pricing-list li:nth-child(-n+2) svg {
      color: var(--t-accent);
    }

    .anara.v2-glass .g-pricing-figure {
      background: linear-gradient(160deg, rgba(142, 16, 140, 0.10) 0%, rgba(201, 165, 108, 0.12) 100%);
      border: 1px solid rgba(142, 16, 140, 0.22);
      position: relative;
    }

    .anara.v2-glass .g-pricing-figure .g-price-fit {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(135deg, var(--t-gold), #B58D52);
      color: #1D0A2F;
      padding: 6px 14px;
      font-weight: 700;
      letter-spacing: 0.08em;
      box-shadow: 0 8px 20px -6px rgba(201, 165, 108, 0.5);
      white-space: nowrap;
      font-size: 11px;
    }

    /* SAMPLE REPORT — promote +6pts callout, add bullets */
    .anara.v2-glass .g-mock-head .g-mock-meta strong {
      font-size: 14px;
      padding: 4px 10px;
      background: rgba(21, 128, 61, 0.12);
      border-radius: 999px;
    }

    .anara.v2-glass .g-sample-copy ul {
      list-style: none;
      padding: 0;
      margin: 0 0 22px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .anara.v2-glass .g-sample-copy ul li {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      font-size: 14.5px;
      color: var(--t-ink-soft);
      line-height: 1.5;
    }

    .anara.v2-glass .g-sample-copy ul li::before {
      content: "";
      flex-shrink: 0;
      width: 6px;
      height: 6px;
      margin-top: 8px;
      background: linear-gradient(135deg, var(--t-accent), var(--t-gold));
      border-radius: 50%;
    }

    /* PROCESS — desaturate bg, promote numbers, bolder arrows */
    .anara.v2-glass .g-process {
      background:
        radial-gradient(ellipse at top right, rgba(166, 46, 226, 0.45) 0%, rgba(74, 11, 107, 0.85) 80%),
        #2A0E3F;
    }

    .anara.v2-glass .g-step-num {
      width: 56px;
      height: 56px;
      font-size: 26px;
      border-radius: 16px;
      background: linear-gradient(135deg, var(--t-accent), #6C0C69);
      box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.4);
    }

    .anara.v2-glass .g-step::after {
      width: 22px;
      height: 3px;
      right: -30px;
      background: linear-gradient(90deg, rgba(201, 165, 108, 0.4) 0%, var(--t-gold) 100%);
    }

    .anara.v2-glass .g-step::before {
      right: -34px;
      border-left-color: var(--t-gold);
    }

    /* GALLERY — caption 70% left-align single-line */
    .anara.v2-glass .g-caption {
      right: auto;
      max-width: 78%;
      padding: 12px 16px;
    }

    .anara.v2-glass .g-caption h3 {
      font-size: 15px;
      margin-bottom: 0;
      line-height: 1.3;
    }

    .anara.v2-glass .g-caption p {
      display: none;
    }

    @media (min-width: 1100px) {
      .anara.v2-glass .g-caption p {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 11.5px;
        margin-top: 2px;
      }
    }

    /* TEAM — anchor CEO card primary */
    .anara.v2-glass .g-leads {
      grid-template-columns: 1.3fr 1fr 1fr;
    }

    .anara.v2-glass .g-lead-card.is-primary {
      background: linear-gradient(180deg, rgba(142, 16, 140, 0.32) 0%, rgba(74, 11, 107, 0.32) 100%);
      border-color: rgba(255, 255, 255, 0.22);
      box-shadow: 0 30px 70px -20px rgba(142, 16, 140, 0.45);
    }

    .anara.v2-glass .g-lead-card.is-primary .g-lead-mark {
      width: 64px;
      height: 64px;
    }

    .anara.v2-glass .g-lead-card.is-primary h3 {
      font-size: 24px;
    }

    .anara.v2-glass .g-lead-card.is-primary .g-lead-role {
      color: var(--t-gold);
    }

    @media (max-width: 860px) {
      .anara.v2-glass .g-leads {
        grid-template-columns: 1fr;
        max-width: 480px;
      }
    }

    /* TEAM — role-card density reduction */
    .anara.v2-glass .g-role-card p {
      font-size: 13.5px;
      line-height: 1.55;
    }

    /* SUPPORTING TEAM SUBHEAD — proper divider frame */
    .anara.v2-glass .g-team-subhead {
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      margin-top: 12px;
      position: relative;
    }

    .anara.v2-glass .g-team-subhead::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--t-gold), transparent);
    }

    /* TESTIMONIALS — remove canned stars, bigger monogram, bigger H2 */
    .anara.v2-glass .g-t-grid .stars {
      display: none;
    }

    .anara.v2-glass .g-t-mono {
      width: 56px;
      height: 56px;
      font-size: 19px;
    }

    .anara.v2-glass .g-t-card>p {
      font-size: 17px;
    }

    .anara.v2-glass .g-t-feature {
      box-shadow: 0 40px 90px -28px rgba(142, 16, 140, 0.5);
    }

    /* FAQ — gold left-border on [open], bigger chev */
    .anara.v2-glass .g-faq-item {
      transition: border-color 0.25s ease;
      border-left: 3px solid transparent;
    }

    .anara.v2-glass .g-faq-item[open] {
      border-left-color: var(--t-gold);
      background: rgba(255, 255, 255, 0.7);
    }

    .anara.v2-glass .g-faq-item .chev {
      width: 32px;
      height: 32px;
    }

    .anara.v2-glass .g-faq-item .chev::before {
      width: 12px;
    }

    .anara.v2-glass .g-faq-item .chev::after {
      height: 12px;
    }

    /* TESTIMONIALS CAROUSEL — rotating image stack + text panel (21st.dev pattern, ported vanilla) */
    .anara.v2-glass .g-tc {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: center;
    }

    .anara.v2-glass .g-tc-stack {
      position: relative;
      aspect-ratio: 1/1;
      width: 100%;
      max-width: 440px;
      margin-left: auto;
      perspective: 1200px;
    }

    .anara.v2-glass .g-tc-slide {
      position: absolute;
      inset: 0;
      margin: 0;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 30px 70px -20px rgba(26, 11, 38, 0.34), 0 0 0 1px rgba(255, 255, 255, 0.4) inset;
      transform-origin: bottom center;
      transition: transform .6s var(--g-ease), opacity .5s var(--g-ease);
      opacity: 0;
      z-index: 1;
      pointer-events: none;
    }

    .anara.v2-glass .g-tc-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .anara.v2-glass .g-tc-slide.is-prev {
      opacity: 0.45;
      z-index: 2;
      transform: rotate(-7deg) scale(0.92) translateY(18px);
    }

    .anara.v2-glass .g-tc-slide.is-next {
      opacity: 0.45;
      z-index: 2;
      transform: rotate(7deg) scale(0.92) translateY(18px);
    }

    .anara.v2-glass .g-tc-slide.is-active {
      opacity: 1;
      z-index: 3;
      transform: rotate(0deg) scale(1) translateY(0);
      pointer-events: auto;
    }

    .anara.v2-glass .g-tc-badge {
      position: absolute;
      left: 20px;
      bottom: 20px;
      z-index: 4;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      font-size: 11.5px;
      letter-spacing: 0.08em;
      font-weight: 600;
      color: var(--t-accent);
      box-shadow: 0 12px 28px -10px rgba(26, 11, 38, 0.32);
    }

    .anara.v2-glass .g-tc-panel {
      display: flex;
      flex-direction: column;
      padding: 8px 0;
      min-height: 320px;
    }

    .anara.v2-glass .g-tc-text {
      display: none;
      flex-direction: column;
      gap: 6px;
      animation: gTcFade .45s var(--g-ease) both;
    }

    .anara.v2-glass .g-tc-text.is-active {
      display: flex;
    }

    @keyframes gTcFade {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .anara.v2-glass .g-tc-text {
        animation: none;
      }
    }

    .anara.v2-glass .g-tc-name {
      font-family: "Fraunces", Georgia, serif;
      font-size: 22px;
      font-weight: 600;
      color: var(--t-ink);
      margin: 0;
      line-height: 1.2;
      letter-spacing: -0.015em;
    }

    .anara.v2-glass .g-tc-role {
      font-size: 13.5px;
      color: var(--t-ink-muted);
      margin: 0;
      letter-spacing: 0.01em;
    }

    .anara.v2-glass .g-tc-quote {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(20px, 2.1vw, 26px);
      line-height: 1.45;
      color: var(--t-ink);
      font-weight: 500;
      letter-spacing: -0.012em;
      margin: 22px 0 0;
    }

    .anara.v2-glass .g-tc-controls {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 40px;
    }

    .anara.v2-glass .g-tc-btn {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.78);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(142, 16, 140, 0.22);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--t-accent);
      cursor: pointer;
      transition: background .25s var(--g-ease), color .25s var(--g-ease), transform .25s var(--g-ease), border-color .25s var(--g-ease);
    }

    .anara.v2-glass .g-tc-btn:hover {
      background: var(--t-accent);
      color: #fff;
      border-color: var(--t-accent);
      box-shadow: 0 10px 22px -8px rgba(142, 16, 140, 0.4);
    }

    .anara.v2-glass .g-tc-btn:focus-visible {
      outline: 2px solid var(--t-gold);
      outline-offset: 3px;
    }

    .anara.v2-glass .g-tc-btn svg {
      width: 18px;
      height: 18px;
      transition: transform .3s var(--g-ease);
    }

    .anara.v2-glass .g-tc-btn[data-tc-prev]:hover svg {
      transform: translateX(-3px);
    }

    .anara.v2-glass .g-tc-btn[data-tc-next]:hover svg {
      transform: translateX(3px);
    }

    .anara.v2-glass .g-tc-progress {
      margin-left: 6px;
      font-size: 12px;
      color: var(--t-ink-quiet);
      letter-spacing: 0.16em;
      font-variant-numeric: tabular-nums;
      font-weight: 600;
    }

    .anara.v2-glass .g-tc-progress .is-current {
      color: var(--t-accent);
    }

    @media (max-width: 880px) {
      .anara.v2-glass .g-tc {
        grid-template-columns: 1fr;
        gap: 36px;
      }

      .anara.v2-glass .g-tc-stack {
        margin: 0 auto;
        max-width: 340px;
      }

      .anara.v2-glass .g-tc-panel {
        min-height: 0;
        text-align: left;
      }
    }

    /* CTA — single col form under 900px, WhatsApp text-link */
    @media (max-width: 900px) {
      .anara.v2-glass .g-lead-form {
        grid-template-columns: 1fr;
      }
    }

    .anara.v2-glass .g-form-actions .btn-ghost-light {
      background: transparent;
      padding: 11px 14px;
      border: 0;
      color: var(--t-gold);
      text-decoration: underline;
      text-underline-offset: 4px;
      font-weight: 500;
      min-width: 0;
    }

    .anara.v2-glass .g-form-actions .btn-ghost-light:hover {
      color: #fff;
    }

    /* ════════════════════════════════════════════════════════════════════════
       PREMIUM REFINEMENT v3 — designer-grade overhaul (May 2026)
       Tokens · clinical purple · flat cards · unified radius · subtle shadows
       Sets the page from "design system showcase" → "premium B2B."
       ════════════════════════════════════════════════════════════════════════ */

    .anara.v2-glass {
      --p-primary: #5B0E59;
      --p-hover: #3F0A3D;
      --p-accent: #8E108C;
      --p-soft: #F5EDF5;
      --p-dark: #1A0B26;
      --p-dark-2: #2D1438;
      --gold: #C9A56C;

      --ink: #14062B;
      --ink-1: #2E1A47;
      --ink-2: #4A3960;
      --ink-3: #6B5C82;
      --hairline: rgba(20, 6, 36, 0.06);
      --hairline-strong: rgba(20, 6, 36, 0.12);

      --r-pill: 999px;
      --r-card: 20px;
      --r-input: 12px;
      --r-focus: 6px;

      --shadow-rest: 0 1px 2px rgba(20, 6, 36, 0.04), 0 4px 12px -4px rgba(20, 6, 36, 0.06);
      --shadow-hover: 0 2px 4px rgba(20, 6, 36, 0.06), 0 12px 24px -8px rgba(20, 6, 36, 0.12);
      --shadow-glass: 0 8px 16px rgba(20, 6, 36, 0.06), 0 32px 64px -16px rgba(20, 6, 36, 0.18);
      --shadow-float: 0 16px 48px -12px rgba(20, 6, 36, 0.16);

      --ease: cubic-bezier(0.22, 1, 0.36, 1);

      --accent: var(--p-primary);
      --accent-soft: var(--p-soft);
      --t-accent: var(--p-primary);
      --g-mesh: radial-gradient(ellipse at top right, #6C1369 0%, #2D0B43 80%);

      --z-base: 1;
      --z-elevated: 10;
      --z-overlay: 100;
      --z-modal: 1000;
    }

    /* Typography — Hero H1 (split-editorial cap, fits above-fold at 1440x900) */
    .anara.v2-glass .g-hero-glass h1 {
      font-size: clamp(32px, 3.6vw, 48px);
      font-weight: 400;
      letter-spacing: -0.032em;
      line-height: 1.06;
      max-width: 24ch;
      margin: 0 0 18px;
    }

    .anara.v2-glass .section-head h2,
    .anara.v2-glass .g-about-glass h2,
    .anara.v2-glass .g-mission-card .mission-text,
    .anara.v2-glass .g-cta-glass h2 {
      font-size: clamp(32px, 3.8vw, 48px);
      font-weight: 400;
      letter-spacing: -0.035em;
      line-height: 1.06;
    }

    .anara.v2-glass .section-head h2 {
      margin-bottom: 20px;
    }

    .anara.v2-glass .section-head .section-sub {
      margin-top: 8px;
      font-size: 17px;
      line-height: 1.6;
    }

    .anara.v2-glass .eyebrow {
      letter-spacing: 0.18em;
      font-weight: 600;
      color: var(--p-primary);
      font-size: 12px;
    }

    .anara.v2-glass .g-section-head-light .eyebrow {
      color: #E9C9F0;
    }

    /* Buttons */
    .anara.v2-glass .btn-primary {
      background: var(--p-primary);
      color: #fff;
      border-radius: 10px;
      padding: 14px 24px;
      font-weight: 600;
      font-size: 15px;
      border: 0;
      box-shadow: 0 1px 2px rgba(91, 14, 89, 0.16);
      transition: background 0.22s var(--ease), box-shadow 0.22s var(--ease), transform 0.18s var(--ease);
    }

    .anara.v2-glass .btn-primary:hover {
      background: var(--p-hover);
      box-shadow: 0 4px 12px -2px rgba(91, 14, 89, 0.4);
      transform: translateY(-1px);
    }

    .anara.v2-glass .btn-primary::after {
      display: none !important;
    }

    .anara.v2-glass .btn-outline {
      background: transparent;
      border: 1px solid rgba(20, 6, 36, 0.16);
      color: var(--ink);
      border-radius: 10px;
      padding: 13px 22px;
      font-weight: 600;
      font-size: 15px;
    }

    .anara.v2-glass .btn-outline:hover {
      border-color: var(--ink);
      background: transparent;
      color: var(--ink);
    }

    .anara.v2-glass .btn span[aria-hidden="true"] {
      display: inline-block;
      transition: transform 0.2s var(--ease);
      margin-left: 4px;
    }

    .anara.v2-glass .btn-primary:hover span[aria-hidden="true"],
    .anara.v2-glass .btn-outline:hover span[aria-hidden="true"] {
      transform: translateX(3px);
    }

    /* Nav refinement */
    .anara.v2-glass .nav-wrap {
      border-bottom: 1px solid rgba(20, 6, 36, 0);
      background: rgba(251, 250, 255, 0.68);
      transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease);
    }

    .anara.v2-glass .nav-wrap[data-scrolled] {
      border-bottom-color: rgba(20, 6, 36, 0.08);
      background: rgba(251, 250, 255, 0.92);
    }

    .anara.v2-glass .nav-wrap .nav {
      min-height: 64px;
      padding-top: 0;
      padding-bottom: 0;
      align-items: center;
    }

    .anara.v2-glass .nav-wrap .btn.btn-pill {
      background: var(--p-primary);
      color: #fff;
      border: 0;
      border-radius: var(--r-pill);
      padding: 9px 18px;
      font-size: 14px;
      font-weight: 600;
    }

    .anara.v2-glass .nav-wrap .btn.btn-pill:hover {
      background: var(--p-hover);
      color: #fff;
    }

    /* Radius normalization */
    .anara.v2-glass .g-glass-card,
    .anara.v2-glass .g-hero-glass,
    .anara.v2-glass .g-mission-card,
    .anara.v2-glass .g-about-glass,
    .anara.v2-glass .g-cta-glass,
    .anara.v2-glass .g-pricing-card,
    .anara.v2-glass .g-not-card,
    .anara.v2-glass .g-compare-card,
    .anara.v2-glass .g-founder-quote,
    .anara.v2-glass .g-sample-mock,
    .anara.v2-glass .g-gcard,
    .anara.v2-glass .g-faq-item,
    .anara.v2-glass .g-tc-slide,
    .anara.v2-glass .g-lead-strip,
    .anara.v2-glass .g-lead-featured {
      border-radius: var(--r-card);
    }

    .anara.v2-glass .g-service-icon,
    .anara.v2-glass .g-p-icon,
    .anara.v2-glass .g-step-num,
    .anara.v2-glass .g-lead-mark {
      border-radius: var(--r-input);
    }

    .anara.v2-glass .g-trust-pill,
    .anara.v2-glass .g-trust,
    .anara.v2-glass .g-svc-tag,
    .anara.v2-glass .g-pills li,
    .anara.v2-glass .g-tc-badge {
      border-radius: var(--r-pill);
    }

    /* Flat white cards (kill glass overuse) */
    .anara.v2-glass .g-why-grid .g-glass-card:not(.is-feature),
    .anara.v2-glass .g-service-card,
    .anara.v2-glass .g-principle-grid .g-p-card,
    .anara.v2-glass .g-faq-item,
    .anara.v2-glass .g-testimonials .g-t-card,
    .anara.v2-glass .g-caption,
    .anara.v2-glass .g-mission-card,
    .anara.v2-glass .g-not-card,
    .anara.v2-glass .g-compare-card,
    .anara.v2-glass .g-pricing-card,
    .anara.v2-glass .g-about-glass {
      background: #FFFFFF;
      border: 1px solid var(--hairline);
      box-shadow: var(--shadow-rest);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .anara.v2-glass .g-faq-item[open] {
      background: #FFFFFF;
    }

    /* Glass kept on hero, founder, CTA */
    .anara.v2-glass .g-hero-glass {
      background: rgba(255, 255, 255, 0.86);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow: var(--shadow-glass);
    }

    .anara.v2-glass .g-founder-quote {
      background: rgba(255, 255, 255, 0.62);
      backdrop-filter: blur(22px) saturate(140%);
      -webkit-backdrop-filter: blur(22px) saturate(140%);
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow: var(--shadow-glass);
    }

    .anara.v2-glass .g-cta-glass {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(22px) saturate(160%);
      -webkit-backdrop-filter: blur(22px) saturate(160%);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 16px 48px -16px rgba(0, 0, 0, 0.4);
    }

    /* Subtle hover lift */
    .anara.v2-glass .g-glass-card:hover,
    .anara.v2-glass a.g-glass-card:hover,
    .anara.v2-glass .g-service-card:hover,
    .anara.v2-glass .g-t-card:hover,
    .anara.v2-glass .g-gcard:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    .anara.v2-glass .g-t-feature {
      transform: none !important;
      background: #FFFFFF;
      border: 2px solid var(--p-primary);
      box-shadow: var(--shadow-rest);
      color: var(--ink);
    }

    .anara.v2-glass .g-t-feature:hover {
      transform: translateY(-2px) !important;
      background: #FFFFFF;
      box-shadow: var(--shadow-hover);
    }

    .anara.v2-glass .g-t-feature p,
    .anara.v2-glass .g-t-feature footer strong {
      color: var(--ink);
    }

    .anara.v2-glass .g-t-feature footer span {
      color: var(--ink-2);
      opacity: 1;
    }

    /* Whitespace bump 20% */
    .anara.v2-glass .g-about,
    .anara.v2-glass .g-why,
    .anara.v2-glass .g-services,
    .anara.v2-glass .g-process,
    .anara.v2-glass .g-gallery,
    .anara.v2-glass .g-team,
    .anara.v2-glass .g-testimonials,
    .anara.v2-glass .g-principles,
    .anara.v2-glass .g-faq,
    .anara.v2-glass .g-cta,
    .anara.v2-glass .g-compare,
    .anara.v2-glass .g-not,
    .anara.v2-glass .g-pricing,
    .anara.v2-glass .g-sample-report,
    .anara.v2-glass .g-founder-break {
      padding-top: 140px;
      padding-bottom: 140px;
    }

    .anara.v2-glass .g-why-grid .g-glass-card,
    .anara.v2-glass .g-principle-grid .g-p-card,
    .anara.v2-glass .g-step,
    .anara.v2-glass .g-service-card {
      padding: 40px 36px;
    }

    .anara.v2-glass .g-service-card {
      padding-bottom: 68px;
    }

    .anara.v2-glass .g-why-grid .g-glass-card.is-feature,
    .anara.v2-glass .g-t-feature {
      padding: 48px 40px;
    }

    .anara.v2-glass .g-mission-card {
      padding: 64px 56px;
    }

    .anara.v2-glass .g-about-glass {
      padding: 48px 44px;
    }

    .anara.v2-glass .g-why-grid {
      gap: 18px;
    }

    /* Mission flat lavender, Process dark mode */
    .anara.v2-glass .g-mission {
      background: #FBFAFF;
      padding: 140px 0;
    }

    .anara.v2-glass .g-mission::after {
      display: none;
    }

    .anara.v2-glass .g-process {
      background: var(--p-dark);
    }

    .anara.v2-glass .g-process::after {
      display: none;
    }

    .anara.v2-glass .g-process .g-step {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: none;
      backdrop-filter: none;
      color: rgba(255, 255, 255, 0.78);
    }

    .anara.v2-glass .g-process .g-step h3 {
      color: #fff;
    }

    .anara.v2-glass .g-process .g-step p {
      color: rgba(255, 255, 255, 0.72);
    }

    .anara.v2-glass .g-process .g-step-num {
      background: var(--gold);
      color: var(--p-dark);
      font-weight: 700;
      box-shadow: none;
    }

    .anara.v2-glass .g-process .g-step::after {
      background: linear-gradient(90deg, rgba(201, 165, 108, 0.4), var(--gold));
    }

    .anara.v2-glass .g-process .g-step::before {
      border-left-color: var(--gold);
    }

    /* CTA mesh purple — only mesh-gradient section */
    .anara.v2-glass .g-cta {
      background: radial-gradient(ellipse at top right, var(--p-primary) 0%, #2D0B43 80%);
    }

    .anara.v2-glass .g-cta::after {
      background: radial-gradient(circle at 15% 80%, rgba(255, 255, 255, 0.06), transparent 45%);
    }

    .anara.v2-glass .g-cta-glass .btn-primary {
      background: #FFFFFF;
      color: var(--p-primary);
      box-shadow: none;
    }

    .anara.v2-glass .g-cta-glass .btn-primary:hover {
      background: rgba(255, 255, 255, 0.94);
      color: var(--p-hover);
    }

    /* Dot grid texture on lavender sections */
    .anara.v2-glass .g-why,
    .anara.v2-glass .g-gallery,
    .anara.v2-glass .g-principles,
    .anara.v2-glass .g-testimonials,
    .anara.v2-glass .g-faq,
    .anara.v2-glass .g-about,
    .anara.v2-glass .g-compare,
    .anara.v2-glass .g-not,
    .anara.v2-glass .g-pricing,
    .anara.v2-glass .g-sample-report {
      background-color: #FBFAFF;
      background-image: radial-gradient(rgba(20, 6, 36, 0.045) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    .anara.v2-glass .g-why::before,
    .anara.v2-glass .g-gallery::before,
    .anara.v2-glass .g-principles::before,
    .anara.v2-glass .g-testimonials::before,
    .anara.v2-glass .g-faq::before {
      display: none;
    }

    /* Trust strip single row */
    .anara.v2-glass .g-trust-strip {
      background: #FFFFFF;
      border-top: 1px solid var(--hairline);
      border-bottom: 1px solid var(--hairline);
      padding: 40px 0;
    }

    .anara.v2-glass .g-trust-inner {
      gap: 18px;
    }

    .anara.v2-glass .g-trust-inner .g-trust-row:nth-of-type(2) {
      border-top: 0;
      padding-top: 0;
    }

    .anara.v2-glass .g-trust-row {
      gap: 8px;
    }

    .anara.v2-glass .g-trust-pill {
      background: transparent !important;
      border: 1px solid var(--hairline-strong) !important;
      padding: 8px 14px !important;
      font-size: 13px;
      color: var(--ink-2);
      font-weight: 500;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .anara.v2-glass .g-trust-pill svg {
      display: none;
    }

    .anara.v2-glass .g-trust-pill strong {
      color: var(--p-primary);
      font-weight: 600;
    }

    .anara.v2-glass .g-trust-pill:hover {
      border-color: var(--p-primary) !important;
      transform: none;
      box-shadow: none;
      color: var(--ink);
    }

    .anara.v2-glass .g-trust-divider {
      height: 18px;
      width: 1px;
      background: var(--hairline-strong);
      margin: 0 6px;
    }

    /* Hero rebuild — kill stock, add phone mockup */
    .anara.v2-glass .g-hero-bleed {
      min-height: clamp(640px, 80vh, 820px);
      background: linear-gradient(155deg, #F2E6F0 0%, #FBFAFF 38%, #ECDEED 100%);
    }

    .anara.v2-glass .g-hero-bleed::before {
      display: none;
    }

    .anara.v2-glass .g-hero-parallax,
    .anara.v2-glass .g-hero-parallax>img {
      display: none !important;
    }

    .anara.v2-glass .g-hero-mesh {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 50% 50% at 85% 15%, rgba(91, 14, 89, 0.16), transparent 60%),
        radial-gradient(ellipse 45% 45% at 5% 95%, rgba(201, 165, 108, 0.12), transparent 60%);
    }

    .anara.v2-glass .g-hero-overlay {
      padding-top: clamp(72px, 9vh, 96px);
      padding-bottom: clamp(40px, 5vh, 64px);
      align-items: center;
      min-height: clamp(560px, 72vh, 720px);
    }

    .anara.v2-glass .g-hero-overlay>.container {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: clamp(28px, 5vw, 80px);
      align-items: center;
      width: 100%;
    }

    .anara.v2-glass .g-hero-glass {
      max-width: none;
      padding: 36px 36px 32px;
    }

    .anara.v2-glass .g-hero-creds {
      margin: 4px 0 18px;
      gap: 6px;
    }

    .anara.v2-glass .g-hero-glass p {
      margin-bottom: 18px;
      font-size: 16px;
    }

    .anara.v2-glass .g-hero-creds span {
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(20, 6, 36, 0.08);
      padding: 7px 12px;
      font-size: 12.5px;
      color: var(--ink-1);
    }

    .anara.v2-glass .g-hero-creds svg {
      color: var(--p-primary);
    }

    .anara.v2-glass .g-hero-side,
    .anara.v2-glass .g-ticker {
      display: none !important;
    }

    /* Phone mockup */
    .anara.v2-glass .g-hero-phone-wrap {
      position: relative;
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
      justify-self: center;
    }

    .anara.v2-glass .g-phone {
      position: relative;
      width: 100%;
      aspect-ratio: 9 / 18;
      background: #0F0420;
      border-radius: 38px;
      padding: 10px;
      box-shadow:
        0 28px 70px -16px rgba(20, 6, 36, 0.36),
        0 0 0 1px rgba(255, 255, 255, 0.06),
        inset 0 0 0 1px rgba(255, 255, 255, 0.04);
      transform: rotate(2.5deg);
    }

    .anara.v2-glass .g-phone::before {
      content: "";
      position: absolute;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      width: 82px;
      height: 22px;
      background: #0F0420;
      border-radius: 999px;
      z-index: 3;
    }

    .anara.v2-glass .g-phone-screen {
      width: 100%;
      height: 100%;
      border-radius: 30px;
      background: linear-gradient(180deg, #E9DCDE 0%, #F1E6E7 100%);
      padding: 46px 10px 14px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .anara.v2-glass .g-phone-head {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 0 6px 8px;
      border-bottom: 1px solid rgba(20, 6, 36, 0.08);
    }

    .anara.v2-glass .g-phone-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--p-primary), var(--p-accent));
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-family: 'Fraunces', serif;
      font-weight: 500;
      font-size: 13px;
      flex-shrink: 0;
    }

    .anara.v2-glass .g-phone-head-text {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

    .anara.v2-glass .g-phone-head-text strong {
      color: var(--ink);
      font-size: 12px;
      font-weight: 600;
      font-family: 'Inter', sans-serif;
    }

    .anara.v2-glass .g-phone-head-text span {
      color: rgba(20, 6, 36, 0.5);
      font-size: 9.5px;
    }

    .anara.v2-glass .g-phone-msgs {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 10px 4px;
      flex: 1;
      overflow: hidden;
    }

    .anara.v2-glass .g-msg {
      font-size: 10.2px;
      line-height: 1.35;
      padding: 7px 10px;
      border-radius: 11px;
      max-width: 78%;
      color: var(--ink);
      box-shadow: 0 1px 1px rgba(20, 6, 36, 0.04);
    }

    .anara.v2-glass .g-msg.from {
      background: #FFFFFF;
      border-bottom-left-radius: 3px;
      align-self: flex-start;
    }

    .anara.v2-glass .g-msg.to {
      background: #DCF8C7;
      border-bottom-right-radius: 3px;
      align-self: flex-end;
    }

    .anara.v2-glass .g-msg strong {
      font-weight: 600;
      color: var(--p-primary);
    }

    .anara.v2-glass .g-msg-time {
      font-size: 8px;
      color: rgba(20, 6, 36, 0.45);
      display: block;
      margin-top: 3px;
      text-align: right;
    }

    .anara.v2-glass .g-phone-input {
      margin-top: 4px;
      background: #FFFFFF;
      border-radius: 999px;
      padding: 5px 10px;
      font-size: 9px;
      color: rgba(20, 6, 36, 0.4);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .anara.v2-glass .g-phone-input::before {
      content: "";
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: rgba(20, 6, 36, 0.06);
    }

    @media (max-width: 980px) {
      .anara.v2-glass .g-hero-overlay>.container {
        grid-template-columns: 1fr;
      }

      .anara.v2-glass .g-hero-phone-wrap {
        max-width: 240px;
        margin-top: 24px;
      }

      .anara.v2-glass .g-phone {
        transform: rotate(0deg);
      }
    }

    /* Stats band */
    .anara.v2-glass .g-stats-band {
      background: #FFFFFF;
      border-bottom: 1px solid var(--hairline);
      padding: 56px 0;
    }

    .anara.v2-glass .g-stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }

    .anara.v2-glass .g-stat {
      padding: 0 28px;
      border-left: 1px solid var(--hairline);
    }

    .anara.v2-glass .g-stat:first-child {
      border-left: 0;
      padding-left: 0;
    }

    .anara.v2-glass .g-stat strong {
      display: block;
      font-family: 'Fraunces', serif;
      font-weight: 400;
      font-size: clamp(36px, 4vw, 52px);
      line-height: 1;
      letter-spacing: -0.03em;
      color: var(--ink);
      margin-bottom: 8px;
    }

    .anara.v2-glass .g-stat strong em {
      font-style: normal;
      font-size: 0.46em;
      color: var(--ink-3);
      letter-spacing: 0;
    }

    .anara.v2-glass .g-stat span {
      font-size: 13px;
      color: var(--ink-2);
      line-height: 1.5;
      display: block;
    }

    @media (max-width: 720px) {
      .anara.v2-glass .g-stats-grid {
        grid-template-columns: 1fr 1fr;
        gap: 32px 0;
      }

      .anara.v2-glass .g-stat:nth-child(3) {
        border-left: 0;
        padding-left: 0;
      }
    }

    /* About dashboard mockup */
    .anara.v2-glass .g-about-media {
      background: linear-gradient(160deg, #F2E6F0 0%, #FBFAFF 100%);
      border-radius: var(--r-card);
      box-shadow: var(--shadow-rest);
      border: 1px solid var(--hairline);
      position: relative;
      overflow: hidden;
    }

    .anara.v2-glass .g-about-media img {
      display: none;
    }

    .anara.v2-glass .g-about-dash {
      position: absolute;
      inset: 32px;
      background: #FFFFFF;
      border-radius: var(--r-card);
      box-shadow: var(--shadow-hover);
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      border: 1px solid var(--hairline);
    }

    .anara.v2-glass .g-dash-frame {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--hairline);
    }

    .anara.v2-glass .g-dash-frame i {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(20, 6, 36, 0.15);
    }

    .anara.v2-glass .g-dash-title {
      font-size: 10.5px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-3);
      font-weight: 600;
    }

    .anara.v2-glass .g-dash-num {
      font-family: 'Fraunces', serif;
      font-weight: 400;
      font-size: 64px;
      line-height: 0.95;
      color: var(--p-primary);
      letter-spacing: -0.03em;
    }

    .anara.v2-glass .g-dash-sub {
      font-size: 12px;
      color: var(--ink-2);
      margin-top: -10px;
    }

    .anara.v2-glass .g-dash-bars {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 4px;
    }

    .anara.v2-glass .g-dash-bar {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .anara.v2-glass .g-dash-bar>span:first-child {
      font-size: 11px;
      color: var(--ink-2);
      min-width: 72px;
    }

    .anara.v2-glass .g-dash-bar .g-dash-track {
      flex: 1;
      height: 6px;
      background: rgba(20, 6, 36, 0.06);
      border-radius: 3px;
      position: relative;
      overflow: hidden;
    }

    .anara.v2-glass .g-dash-bar .g-dash-fill {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      background: linear-gradient(90deg, var(--p-primary), var(--p-accent));
      border-radius: 3px;
    }

    .anara.v2-glass .g-dash-bar>span:last-child {
      font-size: 11px;
      color: var(--ink);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      min-width: 32px;
      text-align: right;
    }

    .anara.v2-glass .g-about-stat {
      background: #FFFFFF;
      backdrop-filter: none;
      border: 1px solid var(--hairline);
      box-shadow: var(--shadow-hover);
      border-radius: var(--r-card);
    }

    /* Gallery product mockups */
    .anara.v2-glass .g-gcard {
      background: #FFFFFF;
      border: 1px solid var(--hairline);
      box-shadow: var(--shadow-rest);
    }

    .anara.v2-glass .g-gcard::before {
      display: none;
    }

    .anara.v2-glass .g-gcard img {
      display: none;
    }

    .anara.v2-glass .g-gcard .g-caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      max-width: none;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.94) 60%, #FFFFFF 100%);
      border: 0;
      border-top: 1px solid var(--hairline);
      backdrop-filter: none;
      padding: 18px 22px;
      box-shadow: none;
      border-radius: 0;
    }

    .anara.v2-glass .g-gcard .g-caption h3 {
      color: var(--ink);
    }

    .anara.v2-glass .g-mockart {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(160deg, #F5EDF5 0%, #FBFAFF 100%);
    }

    .anara.v2-glass .g-gcard[data-mock="whatsapp"] .g-mockart {
      background: linear-gradient(160deg, #E9DCDE 0%, #F1E6E7 100%);
    }

    .anara.v2-glass .g-gcard[data-mock="dashboard"] .g-mockart {
      background: linear-gradient(160deg, var(--p-dark) 0%, var(--p-dark-2) 100%);
    }

    .anara.v2-glass .g-gcard[data-mock="report"] .g-mockart {
      background: linear-gradient(160deg, #FBFAFF 0%, #F2E6F0 100%);
    }

    .anara.v2-glass .g-gcard[data-mock="lab"] .g-mockart {
      background: linear-gradient(160deg, #FBFAFF 0%, #ECDEED 100%);
    }

    .anara.v2-glass .g-mock-wa {
      width: 60%;
      max-width: 220px;
      background: #FFFFFF;
      border-radius: 18px;
      padding: 14px 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      box-shadow: var(--shadow-float);
      border: 1px solid rgba(20, 6, 36, 0.04);
    }

    .anara.v2-glass .g-mock-wa .g-mw-bub {
      padding: 7px 10px;
      border-radius: 11px;
      font-size: 10.5px;
      line-height: 1.35;
      max-width: 88%;
      color: var(--ink);
    }

    .anara.v2-glass .g-mock-wa .g-mw-bub.in {
      background: #F4F1F8;
      align-self: flex-start;
      border-bottom-left-radius: 3px;
    }

    .anara.v2-glass .g-mock-wa .g-mw-bub.out {
      background: #DCF8C7;
      align-self: flex-end;
      border-bottom-right-radius: 3px;
    }

    .anara.v2-glass .g-mock-dash {
      width: 75%;
      max-width: 280px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      box-shadow: 0 8px 32px -8px rgba(0, 0, 0, 0.4);
    }

    .anara.v2-glass .g-mock-dash .g-md-lbl {
      font-size: 9.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.6);
      font-weight: 600;
    }

    .anara.v2-glass .g-mock-dash .g-md-num {
      font-family: 'Fraunces', serif;
      font-size: 36px;
      color: var(--gold);
      font-weight: 400;
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .anara.v2-glass .g-mock-dash .g-md-bar {
      height: 4px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 2px;
      overflow: hidden;
      position: relative;
    }

    .anara.v2-glass .g-mock-dash .g-md-bar::after {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 78%;
      background: linear-gradient(90deg, var(--p-accent), var(--gold));
      border-radius: 2px;
    }

    .anara.v2-glass .g-mock-rep {
      width: 60%;
      max-width: 200px;
      aspect-ratio: 5 / 7;
      background: #FFFFFF;
      border-radius: 6px;
      padding: 20px 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      box-shadow: var(--shadow-float);
      border: 1px solid var(--hairline);
    }

    .anara.v2-glass .g-mock-rep .g-mr-eye {
      font-size: 8.5px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--p-primary);
      font-weight: 600;
    }

    .anara.v2-glass .g-mock-rep .g-mr-title {
      font-family: 'Fraunces', serif;
      font-size: 16px;
      color: var(--ink);
      letter-spacing: -0.01em;
      line-height: 1.2;
      font-weight: 500;
      max-width: 14ch;
    }

    .anara.v2-glass .g-mock-rep .g-mr-meta {
      font-size: 9px;
      color: var(--ink-3);
      margin-top: auto;
    }

    .anara.v2-glass .g-mock-lab {
      width: 75%;
      max-width: 260px;
      background: #FFFFFF;
      border-radius: 14px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-float);
      border: 1px solid var(--hairline);
    }

    .anara.v2-glass .g-mock-lab .g-ml-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10.5px;
      padding: 7px 0;
      border-bottom: 1px solid var(--hairline);
    }

    .anara.v2-glass .g-mock-lab .g-ml-row:last-child {
      border-bottom: 0;
    }

    .anara.v2-glass .g-mock-lab .g-ml-row span:first-child {
      color: var(--ink-2);
    }

    .anara.v2-glass .g-mock-lab .g-ml-row span:last-child {
      color: var(--ink);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }

    .anara.v2-glass .g-mock-lab .g-ml-ok {
      color: #15803D;
    }

    .anara.v2-glass .g-mock-lab .g-ml-warn {
      color: #B91C1C;
    }

    /* Services dark panel */
    .anara.v2-glass .g-services {
      background-color: var(--p-dark);
      background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    .anara.v2-glass .g-services-bg {
      display: none;
    }

    .anara.v2-glass .g-services .g-service-card {
      background: #FFFFFF;
      color: var(--ink);
    }

    .anara.v2-glass .g-services .g-service-card h3 {
      color: var(--ink);
    }

    .anara.v2-glass .g-services .g-service-card p {
      color: var(--ink-2);
    }

    .anara.v2-glass .g-service-icon {
      background: var(--p-soft);
      color: var(--p-primary);
      box-shadow: inset 0 0 0 1px rgba(91, 14, 89, 0.16);
      width: 48px;
      height: 48px;
    }

    .anara.v2-glass .g-services .g-service-card:hover .g-service-icon {
      background: var(--p-primary);
      color: #fff;
      box-shadow: 0 6px 18px -4px rgba(91, 14, 89, 0.32);
    }

    .anara.v2-glass .g-p-icon {
      background: var(--p-soft);
      color: var(--p-primary);
      box-shadow: inset 0 0 0 1px rgba(91, 14, 89, 0.16);
    }

    .anara.v2-glass .g-service-card .arrow {
      background: var(--p-soft);
      color: var(--p-primary);
    }

    .anara.v2-glass .g-service-card:hover .arrow {
      background: var(--p-primary);
      color: #fff;
      box-shadow: 0 4px 12px -2px rgba(91, 14, 89, 0.32);
    }

    /* Team dark panel */
    .anara.v2-glass .g-team {
      background-color: var(--p-dark);
      background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    .anara.v2-glass .g-team-bg {
      display: none;
    }

    /* Comparison table refined */
    .anara.v2-glass .g-compare-card {
      background: #FFFFFF;
      border: 1px solid var(--hairline);
      box-shadow: var(--shadow-rest);
      backdrop-filter: none;
    }

    .anara.v2-glass .g-compare-grid {
      grid-template-columns: 1.3fr 1fr 1fr;
    }

    .anara.v2-glass .g-compare-grid>div {
      border-bottom: 1px solid var(--hairline);
      border-left: 0;
      padding: 20px 24px;
    }

    .anara.v2-glass .g-compare-grid>div+div {
      border-left: 0;
    }

    .anara.v2-glass .g-compare-head {
      padding: 22px 24px !important;
      background: #FBFAFF;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--ink-2);
    }

    .anara.v2-glass .g-compare-head.is-anara {
      background: rgba(91, 14, 89, 0.03);
      border-top: 2px solid var(--p-primary);
      color: var(--p-primary);
      font-weight: 700;
    }

    .anara.v2-glass .g-compare-head.is-anara::before {
      background: var(--p-primary);
      color: #fff;
      box-shadow: none;
      font-size: 10px;
      letter-spacing: 0.14em;
      padding: 4px 10px;
    }

    .anara.v2-glass .g-compare-row-head {
      background: #FFFFFF;
    }

    .anara.v2-glass .g-compare-row-label {
      font-family: 'Fraunces', serif;
      font-weight: 500;
      font-size: 16px;
      letter-spacing: -0.01em;
      color: var(--ink);
    }

    .anara.v2-glass .g-compare-row-label small {
      font-family: 'Inter', sans-serif;
      font-weight: 400;
      color: var(--ink-3);
      font-size: 12.5px;
      letter-spacing: 0;
    }

    .anara.v2-glass .g-compare-val.is-anara {
      background: rgba(91, 14, 89, 0.025);
      color: var(--ink);
    }

    .anara.v2-glass .g-compare-val.is-anara strong {
      color: var(--p-primary);
      font-weight: 600;
    }

    .anara.v2-glass .g-compare-val.is-bad {
      background: #FFFFFF;
      color: var(--ink-2);
    }

    .anara.v2-glass .g-compare-val.is-anara svg {
      width: 22px;
      height: 22px;
      padding: 4px;
      background: var(--p-primary);
      color: #fff;
      border-radius: 50%;
      box-sizing: border-box;
      stroke-width: 2.6;
    }

    .anara.v2-glass .g-compare-val.is-bad svg {
      width: 18px;
      height: 2px;
      background: rgba(20, 6, 36, 0.32);
      color: transparent;
      stroke: transparent;
      border-radius: 1px;
      padding: 0;
      flex-shrink: 0;
      margin-top: 8px;
      align-self: flex-start;
    }

    /* Sample report browser chrome */
    .anara.v2-glass .g-sample-mock {
      background: #FFFFFF;
      border: 1px solid var(--hairline);
      box-shadow: var(--shadow-hover);
      backdrop-filter: none;
      padding: 0;
      overflow: hidden;
    }

    .anara.v2-glass .g-mock-frame {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: #F7F5FB;
      border-bottom: 1px solid var(--hairline);
    }

    .anara.v2-glass .g-mock-dots {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }

    .anara.v2-glass .g-mock-dots i {
      display: block;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: rgba(20, 6, 36, 0.18);
    }

    .anara.v2-glass .g-mock-url {
      flex: 1;
      background: #FFFFFF;
      border: 1px solid var(--hairline);
      border-radius: 8px;
      padding: 5px 12px;
      font-size: 12px;
      color: var(--ink-2);
      letter-spacing: 0.01em;
      max-width: 380px;
      font-family: 'Inter', sans-serif;
    }

    .anara.v2-glass .g-sample-mock .g-mock-body {
      padding: 28px 32px 24px;
    }

    .anara.v2-glass .g-mock-bar {
      height: 10px;
      background: rgba(20, 6, 36, 0.05);
      border-radius: 4px;
      overflow: visible;
    }

    .anara.v2-glass .g-mock-bar i {
      border-radius: 4px;
      height: 100%;
      position: relative;
      width: 0;
      transition: width 0.9s var(--ease);
    }

    .anara.v2-glass .g-mock-bar i::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 50%;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.32), transparent);
      border-radius: 4px 4px 0 0;
      pointer-events: none;
    }

    .anara.v2-glass .g-mock-bar i {
      background: linear-gradient(90deg, var(--p-primary) 0%, var(--gold) 100%);
    }

    .anara.v2-glass .g-mock-bar.is-warn i {
      background: linear-gradient(90deg, #B14E1B 0%, #E89A3F 100%);
    }

    .anara.v2-glass .g-mock-bar.is-good i {
      background: linear-gradient(90deg, #15803D 0%, #4FB37A 100%);
    }

    .anara.v2-glass .g-mock-head .g-mock-meta strong {
      background: rgba(21, 128, 61, 0.1);
      color: #15803D;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .anara.v2-glass .g-spark {
      display: inline-block;
      width: 28px;
      height: 10px;
      vertical-align: middle;
    }

    .anara.v2-glass .g-sample-mock-wrap {
      position: relative;
    }

    .anara.v2-glass .g-sample-callout {
      position: absolute;
      top: 200px;
      right: 12px;
      background: var(--p-dark);
      color: #fff;
      font-size: 12px;
      padding: 12px 14px;
      border-radius: var(--r-input);
      box-shadow: var(--shadow-float);
      max-width: 230px;
      line-height: 1.4;
      z-index: 4;
      pointer-events: none;
    }

    .anara.v2-glass .g-sample-callout strong {
      color: var(--gold);
      font-weight: 600;
    }

    .anara.v2-glass .g-sample-callout::after {
      content: "";
      position: absolute;
      left: -7px;
      top: 16px;
      width: 0;
      height: 0;
      border-right: 8px solid var(--p-dark);
      border-top: 6px solid transparent;
      border-bottom: 6px solid transparent;
    }

    @media (max-width: 980px) {
      .anara.v2-glass .g-sample-callout {
        display: none;
      }
    }

    /* Testimonials solid color blocks */
    .anara.v2-glass .g-tc-slide img {
      display: none;
    }

    .anara.v2-glass .g-tc-slide {
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      border-radius: var(--r-card);
      box-shadow: var(--shadow-hover);
    }

    .anara.v2-glass .g-tc-slide[data-tc-slide="0"] {
      background: linear-gradient(135deg, var(--p-dark) 0%, var(--p-dark-2) 100%);
    }

    .anara.v2-glass .g-tc-slide[data-tc-slide="1"] {
      background: linear-gradient(135deg, var(--p-primary) 0%, var(--p-dark-2) 100%);
    }

    .anara.v2-glass .g-tc-slide[data-tc-slide="2"] {
      background: linear-gradient(135deg, var(--p-dark-2) 0%, var(--p-primary) 100%);
    }

    .anara.v2-glass .g-tc-slide::before {
      content: attr(data-initials);
      font-family: 'Fraunces', serif;
      font-weight: 400;
      font-size: clamp(72px, 8vw, 110px);
      color: rgba(255, 255, 255, 0.16);
      letter-spacing: -0.04em;
    }

    .anara.v2-glass .g-tc-badge {
      background: rgba(255, 255, 255, 0.94);
      border: 1px solid rgba(255, 255, 255, 0.7);
      color: var(--p-primary);
    }

    /* Form: tighter, single column on CTA mesh */
    .anara.v2-glass .g-lead-form {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 28px auto 0;
    }

    .anara.v2-glass .g-lead-form input,
    .anara.v2-glass .g-lead-form select {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 14px 16px;
      border-radius: var(--r-input);
      color: #fff;
      font-size: 15px;
      transition: border-color 0.22s var(--ease), box-shadow 0.22s var(--ease), background 0.22s var(--ease);
    }

    .anara.v2-glass .g-lead-form input::placeholder {
      color: rgba(255, 255, 255, 0.42);
    }

    .anara.v2-glass .g-lead-form input:focus,
    .anara.v2-glass .g-lead-form select:focus {
      border-color: var(--gold);
      background: rgba(255, 255, 255, 0.12);
      box-shadow: 0 0 0 4px rgba(201, 165, 108, 0.18);
    }

    .anara.v2-glass .g-lead-form label {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0;
      text-transform: none;
      color: rgba(255, 255, 255, 0.82);
    }

    .anara.v2-glass .g-lead-form label .req {
      color: var(--gold);
      font-size: 8px;
      vertical-align: 2px;
    }

    .anara.v2-glass .g-form-actions {
      justify-content: flex-start;
      margin-top: 4px;
    }

    .anara.v2-glass .g-form-actions .btn-primary {
      background: #FFFFFF;
      color: var(--p-primary);
    }

    .anara.v2-glass .g-form-actions .btn-primary:hover {
      background: rgba(255, 255, 255, 0.94);
      color: var(--p-hover);
    }

    /* Footer upgrade */
    .anara.v2-glass .g-footer {
      background: var(--p-dark);
      border-top: 1px solid var(--p-dark-2);
      padding-top: 80px;
      padding-bottom: 32px;
    }

    .anara.v2-glass .g-footer .socials a {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.16);
      backdrop-filter: none;
      transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
    }

    .anara.v2-glass .g-footer .socials a:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .anara.v2-glass .f-compliance {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      margin-top: 48px;
      padding: 28px 0 0;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 28px;
      font-size: 12.5px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.6;
    }

    .anara.v2-glass .f-compliance h5 {
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--gold);
      margin: 0 0 8px;
      font-weight: 600;
    }

    .anara.v2-glass .f-compliance p {
      margin: 0 0 4px;
      color: rgba(255, 255, 255, 0.7);
    }

    .anara.v2-glass .f-compliance a {
      color: rgba(255, 255, 255, 0.82);
    }

    .anara.v2-glass .f-compliance a:hover {
      color: var(--gold);
    }

    .anara.v2-glass .f-compliance .f-cin {
      font-size: 11.5px;
      letter-spacing: 0.04em;
      color: rgba(255, 255, 255, 0.5);
      font-family: 'Inter', sans-serif;
    }

    @media (max-width: 720px) {
      .anara.v2-glass .f-compliance {
        grid-template-columns: 1fr;
      }
    }

    /* Misc */
    .anara.v2-glass .g-founder-break {
      background: transparent;
    }

    .anara.v2-glass .g-founder-mark {
      color: var(--p-primary);
      opacity: 0.28;
    }

    .anara.v2-glass main svg[fill="none"][stroke] {
      stroke-width: 1.5 !important;
    }

    .anara.v2-glass .g-compare-val.is-anara svg {
      stroke-width: 2.6 !important;
    }

    .anara.v2-glass .g-pricing-list svg {
      stroke-width: 2 !important;
    }

    .anara.v2-glass .nav-wrap svg {
      stroke-width: 1.8 !important;
    }

    .anara.v2-glass .brand-mark svg {
      stroke-width: 2 !important;
    }

    .anara.v2-glass .g-why-grid .g-glass-card.is-feature {
      background: linear-gradient(180deg, var(--p-primary) 0%, var(--p-hover) 100%);
      border-color: rgba(255, 255, 255, 0.14);
      box-shadow: 0 8px 28px -10px rgba(91, 14, 89, 0.5);
      color: #FFFFFF;
    }

    .anara.v2-glass .g-why-grid .g-glass-card.is-feature .num {
      background: linear-gradient(135deg, #FFFFFF, var(--gold));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .anara.v2-glass .g-pricing-figure {
      background: linear-gradient(160deg, rgba(91, 14, 89, 0.06) 0%, rgba(201, 165, 108, 0.1) 100%);
      border: 1px solid rgba(91, 14, 89, 0.18);
    }

    .anara.v2-glass .g-pricing-figure .g-price-range {
      color: var(--p-primary);
    }

    .anara.v2-glass .g-pricing-figure .g-price-fit {
      background: var(--gold);
      color: var(--p-dark);
    }

    .anara.v2-glass .g-pills li {
      background: #FFFFFF;
      border-color: rgba(91, 14, 89, 0.16);
      color: var(--p-primary);
      backdrop-filter: none;
    }

    .anara.v2-glass .g-pills li:hover {
      background: var(--p-primary);
      color: #FFFFFF;
    }

    .anara.v2-glass .scroll-progress>i {
      background: linear-gradient(90deg, var(--p-primary), var(--gold));
      box-shadow: none;
    }

    .anara.v2-glass .g-fab-call {
      background: var(--p-primary);
    }

    .anara.v2-glass .g-fab-call:hover {
      background: var(--p-hover);
    }

    .anara.v2-glass .nav-links a.is-active::after {
      background: linear-gradient(90deg, var(--p-primary), var(--gold));
    }

    .anara.v2-glass .g-lead-card.is-primary,
    .anara.v2-glass .g-lead-featured {
      background: linear-gradient(180deg, rgba(91, 14, 89, 0.28) 0%, rgba(60, 8, 60, 0.32) 100%);
      border-color: rgba(201, 165, 108, 0.3);
    }

    /* Mobile responsive refinements */
    @media (max-width: 540px) {
      .anara.v2-glass .g-hero-glass {
        padding: 32px 24px;
        border-radius: var(--r-card);
      }

      .anara.v2-glass .g-hero-glass h1 {
        font-size: 32px;
      }

      .anara.v2-glass .g-stats-grid {
        grid-template-columns: 1fr 1fr;
      }

      .anara.v2-glass .g-trust-row {
        flex-wrap: nowrap;
        overflow-x: auto;
        justify-content: flex-start;
        -webkit-overflow-scrolling: touch;
        padding: 0 20px;
        scroll-snap-type: x mandatory;
        max-width: 100%;
        scrollbar-width: none;
      }

      .anara.v2-glass .g-trust-row::-webkit-scrollbar {
        display: none;
      }

      .anara.v2-glass .g-trust-row>li {
        flex-shrink: 0;
        scroll-snap-align: start;
      }

      .anara.v2-glass .g-faq-item summary {
        padding: 24px 20px;
      }

      .anara.v2-glass .g-gcard {
        aspect-ratio: 16 / 9;
        border-radius: var(--r-card);
      }

      .anara.v2-glass .g-gallery-grid {
        grid-auto-rows: auto !important;
      }

      .anara.v2-glass .g-about,
      .anara.v2-glass .g-why,
      .anara.v2-glass .g-services,
      .anara.v2-glass .g-process,
      .anara.v2-glass .g-gallery,
      .anara.v2-glass .g-team,
      .anara.v2-glass .g-testimonials,
      .anara.v2-glass .g-principles,
      .anara.v2-glass .g-faq,
      .anara.v2-glass .g-cta,
      .anara.v2-glass .g-compare,
      .anara.v2-glass .g-not,
      .anara.v2-glass .g-pricing,
      .anara.v2-glass .g-sample-report,
      .anara.v2-glass .g-founder-break {
        padding: 80px 0;
      }
    }

    /* ════════════════════════════════════════════════════════════════════════
       AUDIT FIXES v3.1 — quick wins from taste + ux-heuristics audit
       T1 lock SVG · T2/N4 CTA consistency · T5 editorial heads ·
       N5 inline email validation · N9 inline error state
       ════════════════════════════════════════════════════════════════════════ */

    /* T1 — Browser-chrome URL row: SVG lock, flex layout */
    .anara.v2-glass .g-mock-url {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .anara.v2-glass .g-mock-url svg {
      width: 12px;
      height: 12px;
      color: var(--ink-3);
      flex-shrink: 0;
    }

    /* T5 — Editorial left-aligned section head modifier */
    .anara.v2-glass .section-head--left {
      text-align: left;
      max-width: 760px;
      margin-left: 0;
      margin-right: auto;
    }

    .anara.v2-glass .section-head--left .section-sub {
      margin-left: 0;
      margin-right: 0;
    }

    /* N5 — Inline field validation */
    .anara.v2-glass .g-field-error {
      display: none;
      font-size: 12.5px;
      color: #FFE4A8;
      margin-top: 6px;
      line-height: 1.4;
      letter-spacing: 0.01em;
    }

    .anara.v2-glass .g-field.has-error .g-field-error {
      display: block;
    }

    .anara.v2-glass .g-field.has-error input {
      border-color: rgba(255, 200, 200, 0.45);
      background: rgba(255, 100, 100, 0.04);
    }

    .anara.v2-glass .g-field.has-error input:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 4px rgba(201, 165, 108, 0.18);
    }

    /* N9 — Inline form-error block (replaces alert) */
    .anara.v2-glass .g-form-error {
      grid-column: 1 / -1;
      padding: 16px 20px;
      border-radius: var(--r-input);
      background: rgba(185, 28, 28, 0.18);
      border: 1px solid rgba(255, 140, 140, 0.32);
      color: #fff;
      font-size: 14px;
      line-height: 1.5;
      margin-top: 12px;
      display: none;
    }

    .anara.v2-glass .g-form-error.is-visible {
      display: block;
    }

    .anara.v2-glass .g-form-error a {
      color: var(--gold);
      font-weight: 600;
      border-bottom: 1px solid rgba(201, 165, 108, 0.4);
    }

    .anara.v2-glass .g-form-error a:hover {
      color: #fff;
      border-color: #fff;
    }

    /* ════════════════════════════════════════════════════════════════════════
       HERO v3.2 — Split editorial + portrait stack (from header.html h1)
       Glass card LEFT · 3 product mockups stacked RIGHT · live pill
       Anti-slop: NO stock photography — product visuals only.
       ════════════════════════════════════════════════════════════════════════ */

    /* Layout: 2-col split (taste-skill #3 — anti-center bias) */
    .anara.v2-glass .g-hero-overlay>.container {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(40px, 5vw, 80px);
    }

    /* H1 editorial em accent — italic Fraunces in brand purple */
    .anara.v2-glass .g-hero-glass h1 em {
      font-style: italic;
      font-weight: 400;
      color: var(--p-primary);
      letter-spacing: -0.04em;
    }

    /* Portrait stack — 3 mockup cards, overlapping, rotated */
    .anara.v2-glass .g-hero-stack {
      position: relative;
      width: 100%;
      max-width: 400px;
      aspect-ratio: 4 / 5;
      justify-self: center;
      margin: 0 auto;
    }

    .anara.v2-glass .g-hero-stack .g-stack-card {
      position: absolute;
      background: #FFFFFF;
      border: 1px solid var(--hairline);
      border-radius: 18px;
      box-shadow: 0 24px 60px -16px rgba(20, 6, 36, 0.22), 0 1px 2px rgba(20, 6, 36, 0.06);
      padding: 20px;
      transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
    }

    /* Mini dashboard — back layer, top-left, rotates left */
    .anara.v2-glass .g-hero-stack .g-stack-dash {
      top: 2%;
      left: -4%;
      width: 56%;
      aspect-ratio: 5 / 3;
      background: linear-gradient(160deg, var(--p-dark) 0%, var(--p-dark-2) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transform: rotate(-5deg);
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 18px;
    }

    .anara.v2-glass .g-hero-stack .g-sd-lbl {
      font-size: 9.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.6);
      font-weight: 600;
    }

    .anara.v2-glass .g-hero-stack .g-sd-num {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 38px;
      font-weight: 400;
      color: var(--gold);
      line-height: 1;
      letter-spacing: -0.02em;
      margin: 2px 0;
    }

    .anara.v2-glass .g-hero-stack .g-sd-num em {
      font-style: normal;
      font-size: 0.5em;
      color: rgba(255, 255, 255, 0.5);
    }

    .anara.v2-glass .g-hero-stack .g-sd-sub {
      color: rgba(255, 255, 255, 0.5);
      letter-spacing: 0.04em;
    }

    .anara.v2-glass .g-hero-stack .g-sd-bar {
      height: 4px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 2px;
      overflow: hidden;
      margin-top: 4px;
    }

    .anara.v2-glass .g-hero-stack .g-sd-bar i {
      display: block;
      width: 78%;
      height: 100%;
      background: linear-gradient(90deg, var(--p-accent), var(--gold));
      border-radius: 2px;
    }

    .anara.v2-glass .g-hero-stack .g-sd-delta {
      font-size: 10px;
      color: #4FB37A;
      font-weight: 600;
      letter-spacing: 0.04em;
      margin-top: 2px;
    }

    /* Phone — center, dominant, slight tilt; overrides earlier phone transform */
    .anara.v2-glass .g-hero-stack .g-phone {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-2deg);
      width: 52%;
      height: 92%;
      aspect-ratio: auto;
      margin: 0;
      max-width: none;
      z-index: 3;
    }

    /* Mini lab card — front, bottom-right, rotates right */
    .anara.v2-glass .g-hero-stack .g-stack-lab {
      bottom: 2%;
      right: -4%;
      width: 52%;
      aspect-ratio: 5 / 3.4;
      transform: rotate(5deg);
      z-index: 2;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .anara.v2-glass .g-hero-stack .g-sl-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10px;
      padding: 6px 0;
      border-bottom: 1px solid var(--hairline);
    }

    .anara.v2-glass .g-hero-stack .g-sl-row:last-child {
      border-bottom: 0;
    }

    .anara.v2-glass .g-hero-stack .g-sl-row span:first-child {
      color: var(--ink-2);
    }

    .anara.v2-glass .g-hero-stack .g-sl-row span:last-child {
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }

    .anara.v2-glass .g-hero-stack .g-sl-ok {
      color: #15803D;
    }

    .anara.v2-glass .g-hero-stack .g-sl-warn {
      color: #B91C1C;
    }

    /* Live pill — care-manager status indicator, floats below lab card */
    .anara.v2-glass .g-live-pill {
      position: absolute;
      bottom: -4%;
      right: 8%;
      z-index: 4;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 9px 16px 9px 14px;
      background: #FFFFFF;
      border: 1px solid var(--hairline);
      border-radius: var(--r-pill);
      box-shadow: var(--shadow-float);
      font-size: 13px;
      font-weight: 500;
      color: var(--ink);
      letter-spacing: 0.005em;
      max-width: 240px;
      white-space: normal;
    }

    .anara.v2-glass .g-live-pill .g-live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #2EBE7A;
      box-shadow: 0 0 0 4px rgba(46, 190, 122, 0.2);
      animation: gLivePulse 2s ease-in-out infinite;
      flex-shrink: 0;
    }

    @keyframes gLivePulse {

      0%,
      100% {
        box-shadow: 0 0 0 4px rgba(46, 190, 122, 0.2);
      }

      50% {
        box-shadow: 0 0 0 8px rgba(46, 190, 122, 0.06);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .anara.v2-glass .g-live-pill .g-live-dot {
        animation: none;
      }
    }

    /* Mobile: stack below copy, scale down */
    @media (max-width: 980px) {
      .anara.v2-glass .g-hero-overlay>.container {
        grid-template-columns: 1fr;
        gap: 48px;
      }

      .anara.v2-glass .g-hero-stack {
        max-width: 360px;
        aspect-ratio: 5 / 4;
      }

      .anara.v2-glass .g-hero-stack .g-phone {
        width: 48%;
        height: 110%;
      }
    }

    @media (max-width: 540px) {
      .anara.v2-glass .g-hero-stack {
        max-width: 320px;
        aspect-ratio: 5 / 4;
      }

      .anara.v2-glass .g-hero-stack .g-stack-dash {
        width: 52%;
        padding: 14px;
      }

      .anara.v2-glass .g-hero-stack .g-stack-dash .g-sd-num {
        font-size: 28px;
      }

      .anara.v2-glass .g-hero-stack .g-stack-lab {
        width: 50%;
        padding: 10px 12px;
      }

      .anara.v2-glass .g-hero-stack .g-sl-row {
        font-size: 9px;
        padding: 4px 0;
      }

      .anara.v2-glass .g-live-pill {
        font-size: 11.5px;
        padding: 7px 12px 7px 10px;
        bottom: -6px;
        right: 0;
      }
    }

    /* ════════════════════════════════════════════════════════════════════════
       HERO v4 — Centered single-column hierarchy
       Adapted from 21st.dev hero-with-text-and-two-button → Anara design tokens.
       Top pill → headline+sub → two CTAs · all centered, vertically + horizontally
       Brand: Fraunces h1 · purple primary CTA · gold accent reserved for badge dot
       ════════════════════════════════════════════════════════════════════════ */
    .anara.v2-glass .g-hero-v4 .g-hero-overlay {
      padding-top: clamp(72px, 9vw, 120px);
      padding-bottom: clamp(64px, 8vw, 112px);
      align-items: center;
      min-height: clamp(560px, 78vh, 760px);
    }

    .anara.v2-glass .g-hero-v4 .g-hero-overlay>.container {
      display: block;
      width: 100%;
    }

    .anara.v2-glass .g-hero-stack-v4 {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: clamp(32px, 4vw, 44px);
      max-width: 920px;
      margin: 0 auto;
      text-align: center;
    }

    /* Top eyebrow pill (~React: variant="secondary" size="sm") */
    .anara.v2-glass .g-hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px 16px 8px 14px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(10px) saturate(140%);
      -webkit-backdrop-filter: blur(10px) saturate(140%);
      border: 1px solid rgba(142, 16, 140, 0.18);
      border-radius: var(--r-pill);
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: var(--p-primary);
      letter-spacing: 0.005em;
      text-decoration: none;
      box-shadow: 0 6px 18px -8px rgba(142, 16, 140, 0.28);
      transition: transform 220ms var(--ease), box-shadow 220ms var(--ease), border-color 220ms var(--ease);
    }

    .anara.v2-glass .g-hero-eyebrow:hover {
      transform: translateY(-1px);
      border-color: rgba(142, 16, 140, 0.42);
      box-shadow: 0 10px 24px -8px rgba(142, 16, 140, 0.32);
    }

    .anara.v2-glass .g-hero-eyebrow:focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 4px;
    }

    .anara.v2-glass .g-hero-eyebrow-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--p-primary);
      box-shadow: 0 0 0 3px rgba(142, 16, 140, 0.18);
      flex-shrink: 0;
    }

    .anara.v2-glass .g-hero-eyebrow svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    /* Headline + paragraph block — clear size step: eyebrow 14 → h1 ~64 → sub ~20 → cta 15 */
    .anara.v2-glass .g-hero-v4 .g-hero-heading {
      display: flex;
      flex-direction: column;
      gap: 26px;
      align-items: center;
    }

    .anara.v2-glass .g-hero-v4 h1 {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(40px, 5.4vw, 72px);
      font-weight: 400;
      line-height: 1.08;
      letter-spacing: -0.035em;
      color: var(--ink);
      max-width: 22ch;
      margin: 0;
      text-align: center;
    }

    .anara.v2-glass .g-hero-v4 h1 em {
      font-style: italic;
      font-weight: 400;
      color: var(--p-primary);
      letter-spacing: -0.04em;
    }

    .anara.v2-glass .g-hero-v4 .g-hero-heading p {
      font-family: 'Inter', sans-serif;
      font-size: clamp(18px, 1.4vw, 22px);
      line-height: 1.5;
      letter-spacing: -0.008em;
      color: rgba(29, 10, 47, 0.72);
      font-weight: 400;
      max-width: 58ch;
      margin: 0;
      text-align: center;
    }

    /* CTA row */
    .anara.v2-glass .g-hero-cta-v4 {
      display: flex;
      flex-direction: row;
      gap: 12px;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
    }

    .anara.v2-glass .g-hero-cta-v4 .btn {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      height: 52px;
      padding: 0 28px;
      font-size: 15px;
      font-weight: 600;
    }

    .anara.v2-glass .g-hero-cta-v4 .btn svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }

    /* Mobile */
    @media (max-width: 760px) {
      .anara.v2-glass .g-hero-v4 .g-hero-overlay {
        padding-top: clamp(56px, 14vw, 88px);
        padding-bottom: clamp(56px, 12vw, 80px);
        min-height: 0;
      }

      .anara.v2-glass .g-hero-stack-v4 {
        gap: 26px;
      }

      .anara.v2-glass .g-hero-v4 .g-hero-heading {
        gap: 18px;
      }

      .anara.v2-glass .g-hero-eyebrow {
        font-size: 13px;
        padding: 7px 14px 7px 12px;
      }

      .anara.v2-glass .g-hero-v4 h1 {
        font-size: clamp(32px, 8.4vw, 46px);
        line-height: 1.1;
        letter-spacing: -0.03em;
        max-width: 18ch;
      }

      .anara.v2-glass .g-hero-v4 .g-hero-heading p {
        font-size: 17px;
        line-height: 1.5;
      }

      .anara.v2-glass .g-hero-cta-v4 {
        width: 100%;
        flex-direction: column;
        gap: 10px;
      }

      .anara.v2-glass .g-hero-cta-v4 .btn {
        width: 100%;
        justify-content: center;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .anara.v2-glass .g-hero-eyebrow {
        transition: none;
      }

      .anara.v2-glass .g-hero-eyebrow:hover {
        transform: none;
      }
    }

    /* ────────────────────────────────────────────────────────────────────────
       HERO v4.1 — Text reveal animation + infinite image marquee
       Adapted from ravikatiyar/hero-3 (animated marquee hero).
       Staggered slide-up on eyebrow / h1 lines / sub / CTAs. Edge-masked
       infinite marquee of illustrative engagement photos.
       ──────────────────────────────────────────────────────────────────────── */

    /* Loosen hero min-height now that marquee adds vertical length */
    .anara.v2-glass .g-hero-v4 .g-hero-bleed {
      min-height: auto;
    }

    .anara.v2-glass .g-hero-v4 .g-hero-overlay {
      min-height: auto;
      padding-bottom: 0;
    }

    /* H1 line wrappers — each line clips, inner slides up
       padding-bottom: 0.22em prevents clip-mask from chopping descenders (g/p/y) */
    .anara.v2-glass .g-hero-v4 .g-h1-line {
      display: block;
      overflow: hidden;
      padding: 0.05em 0 0.22em;
    }

    .anara.v2-glass .g-hero-v4 .g-h1-inner {
      display: inline-block;
      will-change: transform, opacity;
      opacity: 0;
      transform: translateY(110%);
      animation: gHeroRevealLine 900ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .anara.v2-glass .g-hero-v4 .g-h1-line:nth-child(1) .g-h1-inner {
      animation-delay: 120ms;
    }

    .anara.v2-glass .g-hero-v4 .g-h1-line:nth-child(2) .g-h1-inner {
      animation-delay: 260ms;
    }

    @keyframes gHeroRevealLine {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Eyebrow + subhead + CTAs — soft fade-up, staggered */
    .anara.v2-glass .g-hero-v4 .g-hero-eyebrow,
    .anara.v2-glass .g-hero-v4 .g-hero-sub-reveal,
    .anara.v2-glass .g-hero-v4 .g-hero-cta-reveal {
      opacity: 0;
      transform: translateY(12px);
      animation: gHeroRevealSoft 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .anara.v2-glass .g-hero-v4 .g-hero-eyebrow {
      animation-delay: 60ms;
    }

    .anara.v2-glass .g-hero-v4 .g-hero-sub-reveal {
      animation-delay: 480ms;
    }

    .anara.v2-glass .g-hero-v4 .g-hero-cta-reveal {
      animation-delay: 620ms;
    }

    @keyframes gHeroRevealSoft {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Marquee — infinite horizontal scroll, edge-masked, staggered fade-in */
    .anara.v2-glass .g-hero-marquee-wrap {
      width: 100%;
      margin-top: clamp(48px, 6vw, 80px);
      padding-bottom: clamp(56px, 7vw, 96px);
      opacity: 0;
      animation: gHeroRevealSoft 900ms cubic-bezier(0.22, 1, 0.36, 1) 760ms forwards;
    }

    .anara.v2-glass .g-hero-marquee {
      position: relative;
      overflow: hidden;
      width: 100%;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
    }

    .anara.v2-glass .g-hero-marquee-track {
      display: flex;
      gap: 16px;
      width: max-content;
      animation: gHeroMarquee 48s linear infinite;
    }

    .anara.v2-glass .g-hero-marquee:hover .g-hero-marquee-track {
      animation-play-state: paused;
    }

    .anara.v2-glass .g-hero-mq-tile {
      flex-shrink: 0;
      width: clamp(180px, 18vw, 260px);
      aspect-ratio: 3 / 4;
      margin: 0;
      border-radius: 18px;
      overflow: hidden;
      background: linear-gradient(160deg, rgba(142, 16, 140, 0.08), rgba(201, 165, 108, 0.06));
      box-shadow: 0 14px 36px -18px rgba(20, 6, 36, 0.22), 0 1px 2px rgba(20, 6, 36, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.6);
    }

    .anara.v2-glass .g-hero-mq-tile img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    @keyframes gHeroMarquee {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(calc(-50% - 8px));
      }
    }

    /* Seamless join into trust strip — soft bottom fade on hero-bleed */
    .anara.v2-glass .g-hero-v4 .g-hero-bleed::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 120px;
      background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.85) 70%, #FFFFFF 100%);
      pointer-events: none;
      z-index: 2;
    }

    .anara.v2-glass .g-hero-v4 .g-hero-bleed {
      position: relative;
    }

    /* Mobile marquee tuning */
    @media (max-width: 760px) {
      .anara.v2-glass .g-hero-marquee-wrap {
        margin-top: clamp(36px, 8vw, 56px);
        padding-bottom: clamp(40px, 10vw, 64px);
      }

      .anara.v2-glass .g-hero-mq-tile {
        width: clamp(140px, 38vw, 180px);
      }

      .anara.v2-glass .g-hero-marquee-track {
        gap: 12px;
        animation-duration: 36s;
      }

      .anara.v2-glass .g-hero-v4 .g-hero-bleed::after {
        height: 80px;
      }
    }

    /* Reduced motion — instant reveal, no marquee scroll */
    @media (prefers-reduced-motion: reduce) {

      .anara.v2-glass .g-hero-v4 .g-h1-inner,
      .anara.v2-glass .g-hero-v4 .g-hero-eyebrow,
      .anara.v2-glass .g-hero-v4 .g-hero-sub-reveal,
      .anara.v2-glass .g-hero-v4 .g-hero-cta-reveal,
      .anara.v2-glass .g-hero-marquee-wrap {
        opacity: 1;
        transform: none;
        animation: none;
      }

      .anara.v2-glass .g-hero-marquee-track {
        animation: none;
      }
    }

    /* =========================================================
       HERO 1 — Split editorial with portrait stack
       ========================================================= */
    .h1 { padding: 24px 0 96px; }
    .h1 .grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 72px;
      align-items: center;
    }
    .h1 .eyebrow { color: var(--accent); }
    .h1 h1 {
      font-family: var(--serif);
      font-size: clamp(40px, 5.4vw, 72px);
      line-height: 1.04;
      letter-spacing: -0.03em;
      font-weight: 500;
      margin: 18px 0 22px;
      max-width: 14ch;
    }
    .h1 h1 em { font-style: italic; color: var(--accent); font-weight: 500; }
    .h1 .lede {
      max-width: 46ch;
      color: var(--ink-2);
      font-size: 17px;
      line-height: 1.6;
      margin: 0 0 30px;
    }
    .h1 .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 40px; }
    .h1 .trust-row {
      display: flex; align-items: center; gap: 22px;
      padding-top: 26px;
      border-top: 1px solid var(--line);
      flex-wrap: wrap;
    }
    .h1 .trust-row .label {
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 600;
    }
    .h1 .trust-row .clients {
      display: flex; gap: 20px; flex-wrap: wrap;
      font-family: var(--serif);
      font-size: 17px;
      color: var(--ink);
      letter-spacing: -0.01em;
      font-weight: 500;
    }
    .h1 .trust-row .clients span { opacity: 0.7; }
    .h1 .stack {
      position: relative;
      aspect-ratio: 4/5;
    }
    .h1 .stack img {
      position: absolute;
      width: 64%;
      height: 56%;
      border-radius: 20px;
      object-fit: cover;
      box-shadow: 0 24px 60px rgba(31, 27, 22, 0.16);
      border: 6px solid #fff;
    }
    .h1 .stack img:nth-child(1) { top: 0; right: 0; transform: rotate(2deg); }
    .h1 .stack img:nth-child(2) { bottom: 20%; left: 0; transform: rotate(-3deg); z-index: 2; }
    .h1 .stack img:nth-child(3) { bottom: 0; right: 6%; transform: rotate(1deg); width: 58%; height: 48%; }
    .h1 .live-pill {
      position: absolute;
      bottom: 12%; right: -8px;
      z-index: 3;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 10px 18px 10px 14px;
      display: inline-flex; align-items: center; gap: 10px;
      box-shadow: 0 10px 30px rgba(31, 27, 22, 0.12);
      font-size: 13px;
      font-weight: 500;
      color: var(--ink);
    }
    .h1 .live-pill .pulse {
      width: 8px; height: 8px; border-radius: 50%;
      background: #2EBE7A;
      box-shadow: 0 0 0 4px rgba(46, 190, 122, 0.2);
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { box-shadow: 0 0 0 4px rgba(46, 190, 122, 0.2); }
      50% { box-shadow: 0 0 0 8px rgba(46, 190, 122, 0.08); }
    }
    @media (max-width: 980px) {
      .h1 .grid { grid-template-columns: 1fr; gap: 48px; }
      .h1 .stack { max-width: 480px; margin: 0 auto; }
    }

    /* =========================================================
       GLASSMORPHISM DEEP LAYER
       Apple Vision Pro × premium Indian health brand
       Surgically scoped to body.anara.v2-glass
       ========================================================= */

    /* 1 · Body — purple mesh gradient canvas */
    body.anara.v2-glass {
      background:
        radial-gradient(ellipse 130% 80% at -8% -4%,  rgba(142,16,140,.15) 0%, transparent 52%),
        radial-gradient(ellipse  80% 120% at 108% 108%, rgba(100,8,112,.12)  0%, transparent 52%),
        radial-gradient(ellipse  60% 50% at 54%  42%,  rgba(200,130,230,.07) 0%, transparent 64%),
        radial-gradient(ellipse  40% 55% at 18%  76%,  rgba(142,16,140,.05)  0%, transparent 50%),
        linear-gradient(158deg, #FDFAFF 0%, #F5EEFF 52%, #F8F3FF 100%);
    }

    /* 2 · Nav — denser, more saturated frost */
    .v2-glass .nav-wrap {
      background: rgba(253,250,255,.86) !important;
      backdrop-filter: blur(32px) saturate(220%) !important;
      -webkit-backdrop-filter: blur(32px) saturate(220%) !important;
      border-bottom: 1px solid rgba(142,16,140,.10) !important;
      box-shadow: 0 1px 0 rgba(255,255,255,.65), 0 4px 28px rgba(142,16,140,.08);
    }

    /* 3 · Hero (.h1) — floating glass copy panel + ambient orbs */
    .v2-glass .h1 { position: relative; overflow: clip; }

    /* decorative orbs */
    .v2-glass .h1::before {
      content: "";
      position: absolute; top: -180px; right: -80px;
      width: 560px; height: 560px; border-radius: 50%;
      background: radial-gradient(circle, rgba(142,16,140,.14) 0%, transparent 70%);
      filter: blur(48px); pointer-events: none; z-index: 0;
    }
    .v2-glass .h1::after {
      content: "";
      position: absolute; bottom: -80px; left: 8%;
      width: 360px; height: 360px; border-radius: 50%;
      background: radial-gradient(circle, rgba(190,110,230,.11) 0%, transparent 70%);
      filter: blur(36px); pointer-events: none; z-index: 0;
    }
    .v2-glass .h1 .container { position: relative; z-index: 1; }

    /* frosted glass copy panel */
    .v2-glass .h1 .copy {
      background: rgba(255,255,255,.76);
      backdrop-filter: blur(36px) saturate(210%);
      -webkit-backdrop-filter: blur(36px) saturate(210%);
      border: 1px solid rgba(255,255,255,.52);
      border-radius: 28px;
      padding: 52px 48px 44px;
      box-shadow:
        0 20px 64px rgba(142,16,140,.11),
        0 4px 18px rgba(0,0,0,.05),
        inset 0 1.5px 0 rgba(255,255,255,.85),
        inset 0 -1px 0 rgba(142,16,140,.05);
    }

    /* live pill — enhanced glass badge */
    .v2-glass .h1 .live-pill {
      background: rgba(255,255,255,.94);
      backdrop-filter: blur(24px) saturate(200%);
      -webkit-backdrop-filter: blur(24px) saturate(200%);
      border: 1px solid rgba(255,255,255,.65);
      box-shadow:
        0 10px 32px rgba(142,16,140,.16),
        inset 0 1.5px 0 rgba(255,255,255,.95);
    }

    /* 4 · Trust strip — frosted bar */
    .v2-glass .g-trust-strip {
      background: rgba(255,255,255,.62);
      backdrop-filter: blur(22px) saturate(170%);
      -webkit-backdrop-filter: blur(22px) saturate(170%);
      border-top: 1px solid rgba(255,255,255,.52);
      border-bottom: 1px solid rgba(255,255,255,.38);
      box-shadow: 0 4px 28px rgba(142,16,140,.06);
    }
    .v2-glass .g-trust-pill {
      background: rgba(255,255,255,.74);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,.48);
      box-shadow: 0 2px 10px rgba(142,16,140,.09), inset 0 1px 0 rgba(255,255,255,.75);
    }

    /* 5 · Stats band — glassy section + per-stat glass cards */
    .v2-glass .g-stats-band {
      background: rgba(255,255,255,.52);
      backdrop-filter: blur(18px) saturate(160%);
      -webkit-backdrop-filter: blur(18px) saturate(160%);
      border-top: 1px solid rgba(255,255,255,.42);
      border-bottom: 1px solid rgba(255,255,255,.32);
    }
    .v2-glass .g-stat {
      background: rgba(255,255,255,.72);
      backdrop-filter: blur(24px) saturate(190%);
      -webkit-backdrop-filter: blur(24px) saturate(190%);
      border: 1px solid rgba(255,255,255,.52);
      border-radius: 22px;
      padding: 26px 22px;
      box-shadow:
        0 8px 28px rgba(142,16,140,.09),
        inset 0 1.5px 0 rgba(255,255,255,.85);
      transition: transform .28s cubic-bezier(.22,1,.36,1), box-shadow .28s cubic-bezier(.22,1,.36,1);
    }
    .v2-glass .g-stat:hover {
      box-shadow: 0 18px 48px rgba(142,16,140,.16), inset 0 1.5px 0 rgba(255,255,255,.9);
    }

    /* 6 · Comparison table — premium glass card */
    .v2-glass .g-compare-card {
      background: rgba(255,255,255,.74);
      backdrop-filter: blur(32px) saturate(190%);
      -webkit-backdrop-filter: blur(32px) saturate(190%);
      border: 1px solid rgba(255,255,255,.52);
      border-radius: 28px;
      box-shadow:
        0 28px 72px rgba(142,16,140,.13),
        inset 0 1.5px 0 rgba(255,255,255,.85);
      overflow: hidden;
    }

    /* 7 · Pricing card */
    .v2-glass .g-pricing-card {
      background: rgba(255,255,255,.80);
      backdrop-filter: blur(32px) saturate(200%);
      -webkit-backdrop-filter: blur(32px) saturate(200%);
      border: 1px solid rgba(255,255,255,.55);
      border-radius: 28px;
      box-shadow:
        0 28px 72px rgba(142,16,140,.13),
        inset 0 1.5px 0 rgba(255,255,255,.90);
    }

    /* 8 · Sample report mock wrap */
    .v2-glass .g-sample-mock-wrap {
      background: rgba(255,255,255,.68);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid rgba(255,255,255,.52);
      border-radius: 26px;
      box-shadow:
        0 24px 64px rgba(142,16,140,.11),
        inset 0 1.5px 0 rgba(255,255,255,.85);
    }

    /* 9 · Gallery cards (.g-gcard) + captions */
    .v2-glass .g-gcard {
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }
    .v2-glass .g-caption {
      background: rgba(255,255,255,.90);
      backdrop-filter: blur(22px) saturate(170%);
      -webkit-backdrop-filter: blur(22px) saturate(170%);
      border: 1px solid rgba(255,255,255,.55);
      box-shadow: 0 8px 28px rgba(142,16,140,.12), inset 0 1px 0 rgba(255,255,255,.85);
    }

    /* 10 · Testimonials — glass panel + slides + controls */
    .v2-glass .g-tc-panel {
      background: rgba(255,255,255,.80);
      backdrop-filter: blur(32px) saturate(200%);
      -webkit-backdrop-filter: blur(32px) saturate(200%);
      border: 1px solid rgba(255,255,255,.55);
      border-radius: 28px;
      box-shadow:
        0 28px 72px rgba(142,16,140,.13),
        inset 0 1.5px 0 rgba(255,255,255,.90);
    }
    .v2-glass .g-tc-slide {
      background: rgba(248,240,255,.88);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border: 1px solid rgba(255,255,255,.48);
      box-shadow: 0 14px 40px rgba(142,16,140,.16);
    }
    .v2-glass .g-tc-btn {
      background: rgba(255,255,255,.82);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,.52);
      box-shadow: 0 4px 14px rgba(142,16,140,.11), inset 0 1px 0 rgba(255,255,255,.85);
      transition: background .2s ease, box-shadow .2s ease;
    }
    .v2-glass .g-tc-btn:hover {
      background: rgba(255,255,255,.96);
      box-shadow: 0 8px 24px rgba(142,16,140,.18), inset 0 1px 0 rgba(255,255,255,.95);
    }

    /* 11 · CTA section — radial purple wash + premium glass panel */
    .v2-glass .g-cta {
      background:
        radial-gradient(ellipse 100% 80% at 50% 50%, rgba(142,16,140,.09) 0%, transparent 68%),
        rgba(248,243,255,.9);
    }
    .v2-glass .g-cta-glass {
      background: rgba(255,255,255,.82) !important;
      backdrop-filter: blur(36px) saturate(220%) !important;
      -webkit-backdrop-filter: blur(36px) saturate(220%) !important;
      border: 1px solid rgba(255,255,255,.58) !important;
      border-radius: 32px !important;
      box-shadow:
        0 36px 88px rgba(142,16,140,.18),
        inset 0 1.5px 0 rgba(255,255,255,.95),
        inset 0 -1px 0 rgba(142,16,140,.06) !important;
    }

    /* Form inputs — light glass surface */
    .v2-glass .g-field input,
    .v2-glass .g-field textarea,
    .v2-glass .g-field select {
      background: rgba(255,255,255,.88) !important;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(210,185,235,.65) !important;
      box-shadow: inset 0 1px 3px rgba(0,0,0,.04), 0 1px 0 rgba(255,255,255,.85);
      transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .v2-glass .g-field input:focus,
    .v2-glass .g-field textarea:focus {
      background: rgba(255,255,255,.98) !important;
      border-color: rgba(142,16,140,.45) !important;
      box-shadow: 0 0 0 3px rgba(142,16,140,.11), inset 0 1px 3px rgba(0,0,0,.03) !important;
      outline: none;
    }

    /* 12 · Sticky FAB — elevated glass chip */
    .v2-glass .g-fab {
      background: rgba(255,255,255,.92) !important;
      backdrop-filter: blur(28px) saturate(200%) !important;
      -webkit-backdrop-filter: blur(28px) saturate(200%) !important;
      border: 1px solid rgba(255,255,255,.65) !important;
      box-shadow: 0 14px 44px rgba(142,16,140,.22), inset 0 1.5px 0 rgba(255,255,255,.95) !important;
    }

    /* 13 · Footer — deep frosted dark glass */
    .v2-glass .g-footer {
      background: rgba(14,7,26,.93) !important;
      backdrop-filter: blur(24px) saturate(160%) !important;
      -webkit-backdrop-filter: blur(24px) saturate(160%) !important;
      border-top: 1px solid rgba(255,255,255,.09) !important;
      box-shadow: 0 -6px 36px rgba(142,16,140,.18) !important;
    }

    /* 14 · Universal g-glass-card — elevated baseline */
    .v2-glass .g-glass-card {
      background: rgba(255,255,255,.78) !important;
      backdrop-filter: blur(28px) saturate(200%) !important;
      -webkit-backdrop-filter: blur(28px) saturate(200%) !important;
      border: 1px solid rgba(255,255,255,.52) !important;
      box-shadow:
        0 14px 40px rgba(142,16,140,.11),
        0 2px 8px rgba(0,0,0,.04),
        inset 0 1.5px 0 rgba(255,255,255,.85) !important;
    }
    .v2-glass .g-glass-card:hover {
      background: rgba(255,255,255,.92) !important;
      box-shadow:
        0 28px 64px rgba(142,16,140,.18),
        0 4px 16px rgba(0,0,0,.06),
        inset 0 1.5px 0 rgba(255,255,255,.95) !important;
    }

    /* 15 · Service cards on dark bg — inverted glass */
    .v2-glass .g-service-card {
      background: rgba(255,255,255,.11) !important;
      backdrop-filter: blur(22px) saturate(160%) !important;
      -webkit-backdrop-filter: blur(22px) saturate(160%) !important;
      border: 1px solid rgba(255,255,255,.20) !important;
      box-shadow:
        0 18px 52px rgba(0,0,0,.22),
        inset 0 1.5px 0 rgba(255,255,255,.22) !important;
    }
    .v2-glass .g-service-card:hover {
      background: rgba(255,255,255,.18) !important;
      box-shadow:
        0 28px 72px rgba(0,0,0,.30),
        inset 0 1.5px 0 rgba(255,255,255,.30) !important;
    }

    /* 16 · Mission card — stronger glow */
    .v2-glass .g-mission-card {
      background: rgba(255,255,255,.94) !important;
      border: 1px solid rgba(255,255,255,.72) !important;
      box-shadow: 0 56px 130px rgba(26,11,38,.44) !important;
    }

    /* 17 · Section background tints */
    .v2-glass .g-about {
      background: rgba(245,238,255,.65) !important;
    }
    .v2-glass .g-why {
      background:
        radial-gradient(ellipse at 0% 0%,  rgba(166,46,226,.11), transparent 50%),
        radial-gradient(ellipse at 100% 100%, rgba(143,16,140,.09), transparent 50%),
        rgba(248,243,255,.75) !important;
    }

    /* 18 · Reduced motion — strip backdrop-filter and hover transforms */
    @media (prefers-reduced-motion: reduce) {
      .v2-glass .h1::before,
      .v2-glass .h1::after { display: none; }
      .v2-glass .h1 .copy,
      .v2-glass .g-stat,
      .v2-glass .g-tc-btn,
      .v2-glass .g-trust-pill,
      .v2-glass .g-trust-strip,
      .v2-glass .g-fab {
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        transition: none;
      }
      .v2-glass .g-stat:hover { transform: none; }
    }

    /* 19 · Responsive hero glass panel padding */
    @media (max-width: 980px) {
      .v2-glass .h1 .copy { padding: 36px 28px 32px; }
    }
    @media (max-width: 480px) {
      .v2-glass .h1 .copy { padding: 28px 20px 24px; }
    }

    /* 20 · Trust-row divider visible against glass copy panel */
    .v2-glass .h1 .trust-row {
      border-top-color: rgba(142,16,140,.12);
    }

    /* 21 · FAB clearance on mobile — prevent CTA button overlap */
    @media (max-width: 768px) {
      .v2-glass .g-cta { padding-bottom: 96px; }
    }

    /* 22 · @supports fallback — solid surfaces when no backdrop-filter */
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .v2-glass .h1 .copy       { background: rgba(255,255,255,.97); }
      .v2-glass .g-trust-strip  { background: rgba(255,255,255,.94); }
      .v2-glass .g-stats-band   { background: rgba(255,255,255,.90); }
      .v2-glass .g-stat         { background: rgba(255,255,255,.96); }
      .v2-glass .g-compare-card { background: #fff; }
      .v2-glass .g-pricing-card { background: #fff; }
      .v2-glass .g-cta-glass    { background: #fff !important; }
      .v2-glass .g-tc-panel     { background: #fff; }
      .v2-glass .g-fab          { background: #fff !important; }
      .v2-glass .g-caption      { background: rgba(255,255,255,.97); }
    }
  </style>
</head>

