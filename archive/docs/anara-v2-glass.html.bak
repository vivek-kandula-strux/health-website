    <section id="about" class="g-about" aria-labelledby="about-title">
      <div class="container g-about-grid">
        <div class="g-about-media">
          <div class="g-about-dash" aria-hidden="true">
            <div class="g-dash-frame">
              <i></i><i></i><i></i>
              <span class="g-dash-title">Population Health · Q2</span>
            </div>
            <div>
              <div class="g-dash-num">87<span style="font-size: 0.45em; color: var(--ink-3);">%</span></div>
              <p class="g-dash-sub">Participation · India deployment, 1,240 employees</p>
            </div>
            <div class="g-dash-bars">
              <div class="g-dash-bar"><span>Cardio risk</span>
                <div class="g-dash-track">
                  <div class="g-dash-fill" style="width: 72%"></div>
                </div><span>72%</span>
              </div>
              <div class="g-dash-bar"><span>BMI &gt; 30</span>
                <div class="g-dash-track">
                  <div class="g-dash-fill" style="width: 14%"></div>
                </div><span>14%</span>
              </div>
              <div class="g-dash-bar"><span>Stress score</span>
                <div class="g-dash-track">
                  <div class="g-dash-fill" style="width: 31%"></div>
                </div><span>31%</span>
              </div>
              <div class="g-dash-bar"><span>Plan accepted</span>
                <div class="g-dash-track">
                  <div class="g-dash-fill" style="width: 91%"></div>
                </div><span>91%</span>
              </div>
